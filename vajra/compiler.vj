# स्मृति सहायक (Memory Helpers)

कार्या read_byte(p) {
    मान b_ptr = malloc(1)
    मान low = 0
    मान high = 255
    मान found = 0
    जबतक (low <= high) {
        मान sum = low + high
        मान mid = sum / 2
        memset(b_ptr, mid, 1)
        मान cmp = memcmp(p, b_ptr, 1)
        यदि (cmp == 0) {
            found = mid
            low = 999999
        } अन्यथा {
            यदि (cmp < 0) {
                high = mid - 1
            } अन्यथा {
                low = mid + 1
            }
        }
    }
    free(b_ptr)
    प्रतिफल found
}

कार्या write_byte(p, val) {
    memset(p, val, 1)
}

कार्या read_i64(p) {
    मान val = 0
    मान idx = 0
    जबतक (idx < 8) {
        मान b = read_byte(p + idx)
        मान mult = 1
        मान j = 0
        जबतक (j < idx) {
            mult = mult * 256
            j = j + 1
        }
        val = val + b * mult
        idx = idx + 1
    }
    प्रतिफल val
}

कार्या write_i64(p, val) {
    मान idx = 0
    मान temp = val
    जबतक (idx < 8) {
        मान div = temp / 256
        मान b = temp - div * 256
        write_byte(p + idx, b)
        temp = div
        idx = idx + 1
    }
}

# फाइल लेखन सहायक (File Writing Helpers)

कार्या लिखो_शब्द(file, s) {
    मान i = 0
    मान c = read_byte(s + i)
    जबतक (c) {
        fputc(c, file)
        i = i + 1
        c = read_byte(s + i)
    }
}

कार्या लिखो_संख्या(file, n) {
    यदि (n == 0) {
        fputc(48, file)
        प्रतिफल 1
    }
    मान temp = n
    यदि (temp < 0) {
        fputc(45, file)
        temp = 0 - temp
    }
    मान digits = malloc(32)
    मान count = 0
    जबतक (temp > 0) {
        मान div = temp / 10
        मान digit = temp - div * 10
        write_byte(digits + count, digit + 48)
        count = count + 1
        temp = div
    }
    जबतक (count > 0) {
        count = count - 1
        fputc(read_byte(digits + count), file)
    }
    free(digits)
    प्रतिफल 1
}

कार्या संख्या_से_शब्द(buf, n) {
    यदि (n == 0) {
        write_byte(buf, 48)
        write_byte(buf + 1, 0)
        प्रतिफल 1
    }
    मान temp = n
    मान offset = 0
    यदि (temp < 0) {
        write_byte(buf, 45)
        offset = 1
        temp = 0 - temp
    }
    मान digits = malloc(32)
    मान count = 0
    जबतक (temp > 0) {
        मान div = temp / 10
        मान digit = temp - div * 10
        write_byte(digits + count, digit + 48)
        count = count + 1
        temp = div
    }
    जबतक (count > 0) {
        count = count - 1
        write_byte(buf + offset, read_byte(digits + count))
        offset = offset + 1
    }
    write_byte(buf + offset, 0)
    free(digits)
    प्रतिफल 1
}

कार्या str_eq(s1, s2) {
    मान cmp = strcmp(s1, s2)
    यदि (cmp == 0) {
        प्रतिफल 1
    }
    प्रतिफल 0
}

# टोकन पहचानकर्ता (Tokens Definitions)

# TOK_EOF = 0
# TOK_FUNCTION = 1
# TOK_LET = 2
# TOK_IF = 3
# TOK_ELSE = 4
# TOK_WHILE = 5
# TOK_RETURN = 6
# TOK_PRINT = 7
# TOK_SPAWN = 8
# TOK_TRUE = 9
# TOK_FALSE = 10
# TOK_MAIN_DEC = 11
# TOK_EXTERN_DEC = 12
# TOK_IMPORT = 13
# TOK_IDENT = 14
# TOK_INT = 15
# TOK_STRING = 16
# TOK_DOT = 17
# TOK_COMMA = 18
# TOK_SEMICOLON = 19
# TOK_LPAREN = 20
# TOK_RPAREN = 21
# TOK_LBRACE = 22
# TOK_RBRACE = 23
# TOK_ASSIGN = 24
# TOK_PLUS = 25
# TOK_MINUS = 26
# TOK_STAR = 27
# TOK_SLASH = 28
# TOK_LT = 29
# TOK_GT = 30
# TOK_EQ = 31
# TOK_LE = 32
# TOK_GE = 33
# TOK_CLASS = 34
# TOK_PUBLIC = 35
# TOK_TRY = 36
# TOK_CATCH = 37
# TOK_THROW = 38

# ऑफसेट्स (Context Offsets)
# STREAM_OFFSET = 0
# CHAR_OFFSET = 8
# TOK_TYPE_OFFSET = 16
# TOK_VAL_OFFSET = 24
# VARS_LIST_OFFSET = 32
# VARS_COUNT_OFFSET = 40

कार्या check_keyword(id_str) {
    यदि (str_eq(id_str, "कार्य")) { प्रतिफल 1 }
    यदि (str_eq(id_str, "कार्या")) { प्रतिफल 1 }
    यदि (str_eq(id_str, "fn")) { प्रतिफल 1 }
    यदि (str_eq(id_str, "function")) { प्रतिफल 1 }

    यदि (str_eq(id_str, "मान")) { प्रतिफल 2 }
    यदि (str_eq(id_str, "अस्तु")) { प्रतिफल 2 }
    यदि (str_eq(id_str, "let")) { प्रतिफल 2 }

    यदि (str_eq(id_str, "यदि")) { प्रतिफल 3 }
    यदि (str_eq(id_str, "चेत्")) { प्रतिफल 3 }
    यदि (str_eq(id_str, "if")) { प्रतिफल 3 }

    यदि (str_eq(id_str, "अन्यथा")) { प्रतिफल 4 }
    यदि (str_eq(id_str, "नोचेत्")) { प्रतिफल 4 }
    यदि (str_eq(id_str, "else")) { प्रतिफल 4 }

    यदि (str_eq(id_str, "जबतक")) { प्रतिफल 5 }
    यदि (str_eq(id_str, "यावत्")) { प्रतिफल 5 }
    यदि (str_eq(id_str, "while")) { प्रतिफल 5 }

    यदि (str_eq(id_str, "प्रतिफल")) { प्रतिफल 6 }
    यदि (str_eq(id_str, "निवर्तय")) { प्रतिफल 6 }
    यदि (str_eq(id_str, "return")) { प्रतिफल 6 }

    यदि (str_eq(id_str, "लिखो")) { प्रतिफल 7 }
    यदि (str_eq(id_str, "print")) { प्रतिफल 7 }
    यदि (str_eq(id_str, "likho")) { प्रतिफल 7 }
    यदि (str_eq(id_str, "मुद्रित")) { प्रतिफल 7 }
    यदि (str_eq(id_str, "mudrit")) { प्रतिफल 7 }

    यदि (str_eq(id_str, "spawn")) { प्रतिफल 8 }
    यदि (str_eq(id_str, "thread")) { प्रतिफल 8 }
    यदि (str_eq(id_str, "parallel")) { प्रतिफल 8 }

    यदि (str_eq(id_str, "सत्य")) { प्रतिफल 9 }
    यदि (str_eq(id_str, "सत्यम्")) { प्रतिफल 9 }
    यदि (str_eq(id_str, "true")) { प्रतिफल 9 }

    यदि (str_eq(id_str, "असत्य")) { प्रतिफल 10 }
    यदि (str_eq(id_str, "असत्यम्")) { प्रतिफल 10 }
    यदि (str_eq(id_str, "false")) { प्रतिफल 10 }

    यदि (str_eq(id_str, "आयात")) { प्रतिफल 13 }
    यदि (str_eq(id_str, "import")) { प्रतिफल 13 }

    यदि (str_eq(id_str, "श्रेणी")) { प्रतिफल 34 }
    यदि (str_eq(id_str, "वर्ग")) { प्रतिफल 34 }
    यदि (str_eq(id_str, "class")) { प्रतिफल 34 }

    यदि (str_eq(id_str, "सार्वजनिक")) { प्रतिफल 35 }
    यदि (str_eq(id_str, "public")) { प्रतिफल 35 }

    यदि (str_eq(id_str, "प्रयत्न")) { प्रतिफल 36 }
    यदि (str_eq(id_str, "प्रयास")) { प्रतिफल 36 }
    यदि (str_eq(id_str, "try")) { प्रतिफल 36 }

    यदि (str_eq(id_str, "ग्रहण")) { प्रतिफल 37 }
    यदि (str_eq(id_str, "पकड़ें")) { प्रतिफल 37 }
    यदि (str_eq(id_str, "catch")) { प्रतिफल 37 }

    यदि (str_eq(id_str, "त्यज")) { प्रतिफल 38 }
    यदि (str_eq(id_str, "फेंकें")) { प्रतिफल 38 }
    यदि (str_eq(id_str, "throw")) { प्रतिफल 38 }

    प्रतिफल 14
}

कार्या is_id_start(b) {
    यदि (b >= 97) {
        यदि (b <= 122) { प्रतिफल 1 }
    }
    यदि (b >= 65) {
        यदि (b <= 90) { प्रतिफल 1 }
    }
    यदि (b == 95) { प्रतिफल 1 }
    यदि (b >= 128) { प्रतिफल 1 }
    प्रतिफल 0
}

कार्या is_id_char(b) {
    यदि (is_id_start(b)) { प्रतिफल 1 }
    यदि (b >= 48) {
        यदि (b <= 57) { प्रतिफल 1 }
    }
    प्रतिफल 0
}

कार्या next_char(ctx) {
    मान stream = read_i64(ctx)
    मान c = fgetc(stream)
    write_i64(ctx + 8, c)
    प्रतिफल c
}

कार्या next_token(ctx) {
    मान c = read_i64(ctx + 8)
    
    # whitespace skip
    मान skipping = 1
    जबतक (skipping) {
        मान is_ws = 0
        यदि (c == 32) { is_ws = 1 }
        यदि (c == 9) { is_ws = 1 }
        यदि (c == 13) { is_ws = 1 }
        यदि (c == 10) { is_ws = 1 }
        
        यदि (is_ws) {
            c = next_char(ctx)
        } अन्यथा {
            यदि (c == 35) { # Comment '#'
                मान in_comment = 1
                जबतक (in_comment) {
                    यदि (c == 10) { in_comment = 0 }
                    यदि (c == 13) { in_comment = 0 }
                    यदि (c == -1) { in_comment = 0 }
                    यदि (c < 0) { in_comment = 0 }
                    यदि (in_comment) {
                        c = next_char(ctx)
                    }
                }
            } अन्यथा {
                skipping = 0
            }
        }
    }

    मान is_eof = 0
    यदि (c == -1) { is_eof = 1 }
    यदि (c < 0) { is_eof = 1 }
    यदि (is_eof) {
        write_i64(ctx + 16, 0)
        प्रतिफल 0
    }

    # @ main / @ extern
    यदि (c == 64) {
        c = next_char(ctx)
        मान buf = malloc(256)
        मान len = 0
        जबतक (is_id_char(c)) {
            write_byte(buf + len, c)
            len = len + 1
            c = next_char(ctx)
        }
        write_byte(buf + len, 0)
        
        यदि (str_eq(buf, "main")) {
            write_i64(ctx + 16, 11)
        } अन्यथा {
            यदि (str_eq(buf, "extern")) {
                write_i64(ctx + 16, 12)
            } अन्यथा {
                write_i64(ctx + 16, 0)
            }
        }
        free(buf)
        प्रतिफल read_i64(ctx + 16)
    }

    यदि (c == 46) { write_i64(ctx + 16, 17); next_char(ctx); प्रतिफल 17; }
    यदि (c == 44) { write_i64(ctx + 16, 18); next_char(ctx); प्रतिफल 18; }
    यदि (c == 59) { write_i64(ctx + 16, 19); next_char(ctx); प्रतिफल 19; }
    यदि (c == 40) { write_i64(ctx + 16, 20); next_char(ctx); प्रतिफल 20; }
    यदि (c == 41) { write_i64(ctx + 16, 21); next_char(ctx); प्रतिफल 21; }
    यदि (c == 123) { write_i64(ctx + 16, 22); next_char(ctx); प्रतिफल 22; }
    यदि (c == 125) { write_i64(ctx + 16, 23); next_char(ctx); प्रतिफल 23; }
    यदि (c == 43) { write_i64(ctx + 16, 25); next_char(ctx); प्रतिफल 25; }
    यदि (c == 45) { write_i64(ctx + 16, 26); next_char(ctx); प्रतिफल 26; }
    यदि (c == 42) { write_i64(ctx + 16, 27); next_char(ctx); प्रतिफल 27; }
    यदि (c == 47) { write_i64(ctx + 16, 28); next_char(ctx); प्रतिफल 28; }

    यदि (c == 61) {
        c = next_char(ctx)
        यदि (c == 61) {
            write_i64(ctx + 16, 31)
            next_char(ctx)
            प्रतिफल 31
        } अन्यथा {
            write_i64(ctx + 16, 24)
            प्रतिफल 24
        }
    }
    यदि (c == 60) {
        c = next_char(ctx)
        यदि (c == 61) {
            write_i64(ctx + 16, 32)
            next_char(ctx)
            प्रतिफल 32
        } अन्यथा {
            write_i64(ctx + 16, 29)
            प्रतिफल 29
        }
    }
    यदि (c == 62) {
        c = next_char(ctx)
        यदि (c == 61) {
            write_i64(ctx + 16, 33)
            next_char(ctx)
            प्रतिफल 33
        } अन्यथा {
            write_i64(ctx + 16, 30)
            प्रतिफल 30
        }
    }

    # String literals
    यदि (c == 34) {
        c = next_char(ctx)
        मान buf = malloc(1024)
        मान len = 0
        मान in_str = 1
        जबतक (in_str) {
            यदि (c == 34) { in_str = 0 }
            यदि (c == -1) { in_str = 0 }
            यदि (c < 0) { in_str = 0 }
            यदि (in_str) {
                write_byte(buf + len, c)
                len = len + 1
                c = next_char(ctx)
            }
        }
        write_byte(buf + len, 0)
        next_char(ctx) # skip closing "
        
        मान old_val = read_i64(ctx + 24)
        यदि (old_val) { free(old_val) }
        write_i64(ctx + 24, buf)
        write_i64(ctx + 16, 16)
        प्रतिफल 16
    }

    # Numeric literals
    मान is_digit_start = 0
    यदि (c >= 48) {
        यदि (c <= 57) { is_digit_start = 1 }
    }
    यदि (is_digit_start) {
        मान buf = malloc(64)
        मान len = 0
        मान is_digit = 0
        यदि (c >= 48) {
            यदि (c <= 57) { is_digit = 1 }
        }
        जबतक (is_digit) {
            write_byte(buf + len, c)
            len = len + 1
            c = next_char(ctx)
            is_digit = 0
            यदि (c >= 48) {
                यदि (c <= 57) { is_digit = 1 }
            }
        }
        write_byte(buf + len, 0)
        
        मान old_val = read_i64(ctx + 24)
        यदि (old_val) { free(old_val) }
        write_i64(ctx + 24, buf)
        write_i64(ctx + 16, 15)
        प्रतिफल 15
    }

    # Identifiers & Keywords
    यदि (is_id_start(c)) {
        मान buf = malloc(256)
        मान len = 0
        जबतक (is_id_char(c)) {
            write_byte(buf + len, c)
            len = len + 1
            c = next_char(ctx)
        }
        write_byte(buf + len, 0)
        
        मान old_val = read_i64(ctx + 24)
        यदि (old_val) { free(old_val) }
        write_i64(ctx + 24, buf)
        
        मान type = check_keyword(buf)
        write_i64(ctx + 16, type)
        प्रतिफल type
    }

    write_i64(ctx + 16, 0)
    next_char(ctx)
    प्रतिफल 0
}

# Pass 1: Forward Declarations Scanner

कार्या pass1_scan_file(path, out_file, scanned_files, scanned_files_count_ptr) {
    मान count = read_i64(scanned_files_count_ptr)
    मान idx = 0
    मान already_scanned = 0
    जबतक (idx < count) {
        मान p_path = read_i64(scanned_files + idx * 8)
        यदि (strcmp(p_path, path) == 0) {
            already_scanned = 1
            idx = count
        } अन्यथा {
            idx = idx + 1
        }
    }
    यदि (already_scanned) {
        प्रतिफल 1
    }

    मान path_copy = malloc(strlen(path) + 1)
    strcpy(path_copy, path)
    write_i64(scanned_files + count * 8, path_copy)
    write_i64(scanned_files_count_ptr, count + 1)

    मान stream = fopen(path, "r")
    यदि (stream == 0) {
        प्रतिफल 0
    }

    मान ctx = malloc(256)
    write_i64(ctx, stream)
    write_i64(ctx + 8, 0)
    write_i64(ctx + 16, 0)
    write_i64(ctx + 24, 0)
    next_char(ctx)

    मान tok = next_token(ctx)
    मान loop_scan = 1
    जबतक (loop_scan) {
        यदि (tok == 0) {
            loop_scan = 0
        } अन्यथा {
            यदि (tok == 13) { # आयात
                tok = next_token(ctx)
                यदि (tok == 16) {
                    pass1_scan_file(read_i64(ctx + 24), out_file, scanned_files, scanned_files_count_ptr)
                }
            } अन्यथा {
                यदि (tok == 12) { # @extern
                    tok = next_token(ctx)
                    यदि (tok == 1) {
                        tok = next_token(ctx)
                        यदि (tok == 14) {
                            मान func_name = malloc(256)
                            strcpy(func_name, read_i64(ctx + 24))
                            tok = next_token(ctx) # '('
                            tok = next_token(ctx)
                            
                            लिखो_शब्द(out_file, "extern long long ")
                            लिखो_शब्द(out_file, func_name)
                            लिखो_शब्द(out_file, "(")
                            
                            मान param_count = 0
                            मान loop_param = 1
                            जबतक (loop_param) {
                                यदि (tok == 21) { loop_param = 0 }
                                यदि (tok == 0) { loop_param = 0 }
                                यदि (loop_param) {
                                    यदि (tok == 14) {
                                        यदि (param_count > 0) {
                                            लिखो_शब्द(out_file, ", ")
                                        }
                                        लिखो_शब्द(out_file, "long long ")
                                        param_count = param_count + 1
                                    }
                                    tok = next_token(ctx)
                                }
                            }
                            लिखो_शब्द(out_file, ");\n")
                            free(func_name)
                        }
                    }
                } अन्यथा {
                    यदि (tok == 1) { # function
                        tok = next_token(ctx)
                        यदि (tok == 14) {
                            मान func_name = malloc(256)
                            strcpy(func_name, read_i64(ctx + 24))
                            tok = next_token(ctx) # '('
                            tok = next_token(ctx)
                            
                            लिखो_शब्द(out_file, "long long ")
                            लिखो_शब्द(out_file, func_name)
                            लिखो_शब्द(out_file, "(")
                            
                            मान param_count = 0
                            मान loop_param = 1
                            जबतक (loop_param) {
                                यदि (tok == 21) { loop_param = 0 }
                                यदि (tok == 0) { loop_param = 0 }
                                यदि (loop_param) {
                                    यदि (tok == 14) {
                                        यदि (param_count > 0) {
                                            लिखो_शब्द(out_file, ", ")
                                        }
                                        लिखो_शब्द(out_file, "long long ")
                                        param_count = param_count + 1
                                    }
                                    tok = next_token(ctx)
                                }
                            }
                            लिखो_शब्द(out_file, ");\n")
                            free(func_name)
                        }
                    }
                }
            }
            tok = next_token(ctx)
        }
    }

    fclose(stream)
    मान last_val = read_i64(ctx + 24)
    यदि (last_val) { free(last_val) }
    free(ctx)
    प्रतिफल 1
}

# Pass 2: Parser & C Code Generator

# Forward Declarations
@extern
कार्या parse_expr_string(ctx)

@extern
कार्या parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)

@extern
कार्या parse_file(path, out_file, parsed_files, parsed_files_count_ptr)


कार्या parse_primary_string(ctx) {
    मान tok = read_i64(ctx + 16)
    
    यदि (tok == 26) { # unary minus
        next_token(ctx)
        मान sub = parse_primary_string(ctx)
        मान res = malloc(strlen(sub) + 4)
        strcpy(res, "-")
        strcat(res, sub)
        free(sub)
        प्रतिफल res
    }

    यदि (tok == 15) { # INT
        मान val = read_i64(ctx + 24)
        मान res = malloc(strlen(val) + 1)
        strcpy(res, val)
        next_token(ctx)
        प्रतिफल res
    }
    
    यदि (tok == 16) { # STRING
        मान val = read_i64(ctx + 24)
        मान res = malloc(strlen(val) + 3)
        write_byte(res, 34)
        strcpy(res + 1, val)
        write_byte(res + 1 + strlen(val), 34)
        write_byte(res + 2 + strlen(val), 0)
        next_token(ctx)
        प्रतिफल res
    }
    
    यदि (tok == 9) { # TRUE
        मान res = malloc(2)
        strcpy(res, "1")
        next_token(ctx)
        प्रतिफल res
    }
    
    यदि (tok == 10) { # FALSE
        मान res = malloc(2)
        strcpy(res, "0")
        next_token(ctx)
        प्रतिफल res
    }
    
    यदि (tok == 14) { # IDENT
        मान name = malloc(256)
        strcpy(name, read_i64(ctx + 24))
        next_token(ctx)
        
        # Check if function call '('
        यदि (read_i64(ctx + 16) == 20) {
            next_token(ctx) # consume '('
            
            मान args_str = malloc(1024)
            strcpy(args_str, "")
            
            मान arg_count = 0
            मान loop_args = 1
            जबतक (loop_args) {
                मान t = read_i64(ctx + 16)
                यदि (t == 21) { loop_args = 0 }
                यदि (t == 0) { loop_args = 0 }
                यदि (loop_args) {
                    यदि (arg_count > 0) {
                        strcat(args_str, ", ")
                    }
                    मान arg = parse_expr_string(ctx)
                    strcat(args_str, arg)
                    free(arg)
                    arg_count = arg_count + 1
                    
                    यदि (read_i64(ctx + 16) == 18) {
                        next_token(ctx) # consume ','
                    }
                }
            }
            next_token(ctx) # consume ')'
            
            मान res = malloc(strlen(name) + strlen(args_str) + 3)
            strcpy(res, name)
            strcat(res, "(")
            strcat(res, args_str)
            strcat(res, ")")
            free(name)
            free(args_str)
            प्रतिफल res
        } अन्यथा {
            प्रतिफल name
        }
    }
    
    यदि (tok == 20) { # '('
        next_token(ctx)
        मान sub = parse_expr_string(ctx)
        next_token(ctx) # ')'
        
        मान res = malloc(strlen(sub) + 3)
        strcpy(res, "(")
        strcat(res, sub)
        strcat(res, ")")
        free(sub)
        प्रतिफल res
    }
    
    मान empty = malloc(1)
    write_byte(empty, 0)
    next_token(ctx)
    प्रतिफल empty
}

कार्या is_operator(tok) {
    यदि (tok == 25) { प्रतिफल 1 }
    यदि (tok == 26) { प्रतिफल 1 }
    यदि (tok == 27) { प्रतिफल 1 }
    यदि (tok == 28) { प्रतिफल 1 }
    यदि (tok == 29) { प्रतिफल 1 }
    यदि (tok == 30) { प्रतिफल 1 }
    यदि (tok == 31) { प्रतिफल 1 }
    यदि (tok == 32) { प्रतिफल 1 }
    यदि (tok == 33) { प्रतिफल 1 }
    प्रतिफल 0
}

कार्या parse_expr_string(ctx) {
    मान left = parse_primary_string(ctx)
    
    # Check for method calls (dots)
    मान loop_dot = 1
    जबतक (loop_dot) {
        यदि (read_i64(ctx + 16) == 17) { # '.'
            next_token(ctx)
            यदि (read_i64(ctx + 16) == 14) { # method name
                मान method_name = malloc(256)
                strcpy(method_name, read_i64(ctx + 24))
                next_token(ctx)
                
                यदि (read_i64(ctx + 16) == 20) { # '('
                    next_token(ctx)
                    मान arg = parse_expr_string(ctx)
                    next_token(ctx) # ')'
                    
                    मान op = "+"
                    यदि (str_eq(method_name, "add")) { op = "+" }
                    यदि (str_eq(method_name, "sub")) { op = "-" }
                    यदि (str_eq(method_name, "mul")) { op = "*" }
                    यदि (str_eq(method_name, "div")) { op = "/" }
                    
                    मान new_left = malloc(strlen(left) + strlen(arg) + 16)
                    strcpy(new_left, "(")
                    strcat(new_left, left)
                    strcat(new_left, " ")
                    strcat(new_left, op)
                    strcat(new_left, " ")
                    strcat(new_left, arg)
                    strcat(new_left, ")")
                    
                    free(left)
                    free(arg)
                    free(method_name)
                    left = new_left
                } अन्यथा {
                    # Property access
                    मान new_left = malloc(strlen(left) + strlen(method_name) + 4)
                    strcpy(new_left, left)
                    strcat(new_left, "->")
                    strcat(new_left, method_name)
                    free(left)
                    free(method_name)
                    left = new_left
                }
            }
        } अन्यथा {
            loop_dot = 0
        }
    }
    
    # Check for assignment '='
    यदि (read_i64(ctx + 16) == 24) { # '='
        next_token(ctx)
        मान right = parse_expr_string(ctx)
        
        # Check if left is simple identifier for local declaration
        मान is_simple = 1
        मान s_len = strlen(left)
        मान s_idx = 0
        जबतक (s_idx < s_len) {
            मान sc = read_byte(left + s_idx)
            यदि (sc == 40) { is_simple = 0; s_idx = s_len; }
            यदि (sc == 46) { is_simple = 0; s_idx = s_len; }
            यदि (sc == 61) { is_simple = 0; s_idx = s_len; }
            यदि (is_simple) { s_idx = s_idx + 1 }
        }
        
        मान res = 0
        यदि (is_simple) {
            मान vars_list = read_i64(ctx + 32)
            मान vars_count = read_i64(ctx + 40)
            मान found = 0
            मान idx = 0
            जबतक (idx < vars_count) {
                मान v_name = read_i64(vars_list + idx * 8)
                यदि (strcmp(v_name, left) == 0) {
                    found = 1
                    idx = vars_count
                } अन्यथा {
                    idx = idx + 1
                }
            }
            
            यदि (found) {
                res = malloc(strlen(left) + strlen(right) + 8)
                strcpy(res, left)
                strcat(res, " = ")
                strcat(res, right)
            } अन्यथा {
                res = malloc(strlen(left) + strlen(right) + 24)
                strcpy(res, "long long ")
                strcat(res, left)
                strcat(res, " = ")
                strcat(res, right)
                
                मान left_copy = malloc(strlen(left) + 1)
                strcpy(left_copy, left)
                write_i64(vars_list + vars_count * 8, left_copy)
                write_i64(ctx + 40, vars_count + 1)
            }
        } अन्यथा {
            res = malloc(strlen(left) + strlen(right) + 8)
            strcpy(res, left)
            strcat(res, " = ")
            strcat(res, right)
        }
        free(left)
        free(right)
        left = res
        प्रतिफल left
    }

    # Binary operators
    मान tok = read_i64(ctx + 16)
    जबतक (is_operator(tok)) {
           
        मान op_str = "+"
        यदि (tok == 25) { op_str = "+" }
        यदि (tok == 26) { op_str = "-" }
        यदि (tok == 27) { op_str = "*" }
        यदि (tok == 28) { op_str = "/" }
        यदि (tok == 29) { op_str = "<" }
        यदि (tok == 30) { op_str = ">" }
        यदि (tok == 31) { op_str = "==" }
        यदि (tok == 32) { op_str = "<=" }
        यदि (tok == 33) { op_str = ">=" }
        
        next_token(ctx)
        मान right = parse_expr_string(ctx)
        
        मान new_left = malloc(strlen(left) + strlen(right) + 8)
        strcpy(new_left, "(")
        strcat(new_left, left)
        strcat(new_left, " ")
        strcat(new_left, op_str)
        strcat(new_left, " ")
        strcat(new_left, right)
        strcat(new_left, ")")
        
        free(left)
        free(right)
        left = new_left
        tok = read_i64(ctx + 16)
    }

    # spawn keyword handling (parsed as expression)
    यदि (tok == 8) { # SPAWN
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 14) {
            मान fn_name = malloc(256)
            strcpy(fn_name, read_i64(ctx + 24))
            next_token(ctx)
            
            यदि (read_i64(ctx + 16) == 20) { # '('
                next_token(ctx)
                मान loop_spawn = 1
                जबतक (loop_spawn) {
                    मान t = read_i64(ctx + 16)
                    यदि (t == 21) { loop_spawn = 0 }
                    यदि (t == 0) { loop_spawn = 0 }
                    यदि (loop_spawn) { next_token(ctx) }
                }
                next_token(ctx)
            }
            
            मान res = malloc(strlen(fn_name) + 32)
            strcpy(res, "vajra_spawn((void*)")
            strcat(res, fn_name)
            strcat(res, ")")
            free(fn_name)
            free(left)
            left = res
        }
    }

    प्रतिफल left
}

कार्या parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr) {
    मान tok = read_i64(ctx + 16)
    
    यदि (tok == 13) { # आयात / import
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 16) {
            मान path = read_i64(ctx + 24)
            next_token(ctx)
            parse_file(path, out_file, parsed_files, parsed_files_count_ptr)
        }
        प्रतिफल 1
    }
    
    यदि (tok == 11) { # @main
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 1) { next_token(ctx) }
        
        यदि (read_i64(ctx + 16) == 14) {
            मान name = read_i64(ctx + 24)
            next_token(ctx)
            
            यदि (read_i64(ctx + 16) == 20) {
                next_token(ctx)
                मान loop_main_params = 1
                जबतक (loop_main_params) {
                    मान t = read_i64(ctx + 16)
                    यदि (t == 21) { loop_main_params = 0 }
                    यदि (t == 0) { loop_main_params = 0 }
                    यदि (loop_main_params) { next_token(ctx) }
                }
                next_token(ctx)
            }
            यदि (read_i64(ctx + 16) == 22) { next_token(ctx) }
            
            लिखो_शब्द(out_file, "long long मुख्य() {\n")
            
            # Reset vars count
            write_i64(ctx + 40, 0)
            
            मान loop_main_stmts = 1
            जबतक (loop_main_stmts) {
                मान t = read_i64(ctx + 16)
                यदि (t == 23) { loop_main_stmts = 0 }
                यदि (t == 0) { loop_main_stmts = 0 }
                यदि (loop_main_stmts) {
                    parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
                }
            }
            यदि (read_i64(ctx + 16) == 23) { next_token(ctx) }
            लिखो_शब्द(out_file, "}\n")
        }
        प्रतिफल 1
    }
    
    यदि (tok == 12) { # @extern
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 1) { next_token(ctx) }
        यदि (read_i64(ctx + 16) == 14) { next_token(ctx) }
        यदि (read_i64(ctx + 16) == 20) {
            next_token(ctx)
            मान loop_ext_params = 1
            जबतक (loop_ext_params) {
                मान t = read_i64(ctx + 16)
                यदि (t == 21) { loop_ext_params = 0 }
                यदि (t == 0) { loop_ext_params = 0 }
                यदि (loop_ext_params) { next_token(ctx) }
            }
            next_token(ctx)
        }
        प्रतिफल 1
    }
    
    यदि (tok == 1) { # function / कार्य
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 14) {
            मान name = malloc(256)
            strcpy(name, read_i64(ctx + 24))
            next_token(ctx)
            
            लिखो_शब्द(out_file, "long long ")
            लिखो_शब्द(out_file, name)
            लिखो_शब्द(out_file, "(")
            
            # Param vars list
            write_i64(ctx + 40, 0)
            मान vars_list = read_i64(ctx + 32)
            
            मान param_count = 0
            यदि (read_i64(ctx + 16) == 20) {
                next_token(ctx)
                मान loop_fn_params = 1
                जबतक (loop_fn_params) {
                    मान t = read_i64(ctx + 16)
                    यदि (t == 21) { loop_fn_params = 0 }
                    यदि (t == 0) { loop_fn_params = 0 }
                    यदि (loop_fn_params) {
                        यदि (t == 14) {
                            मान p_name = read_i64(ctx + 24)
                            यदि (param_count > 0) { लिखो_शब्द(out_file, ", ") }
                            लिखो_शब्द(out_file, "long long ")
                            लिखो_शब्द(out_file, p_name)
                            
                            # Add to vars list
                            मान p_copy = malloc(strlen(p_name) + 1)
                            strcpy(p_copy, p_name)
                            write_i64(vars_list + param_count * 8, p_copy)
                            param_count = param_count + 1
                        }
                        next_token(ctx)
                    }
                }
                next_token(ctx)
            }
            write_i64(ctx + 40, param_count)
            लिखो_शब्द(out_file, ") {\n")
            
            यदि (read_i64(ctx + 16) == 22) { next_token(ctx) }
            
            मान loop_fn_stmts = 1
            जबतक (loop_fn_stmts) {
                मान t = read_i64(ctx + 16)
                यदि (t == 23) { loop_fn_stmts = 0 }
                यदि (t == 0) { loop_fn_stmts = 0 }
                यदि (loop_fn_stmts) {
                    parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
                }
            }
            यदि (read_i64(ctx + 16) == 23) { next_token(ctx) }
            लिखो_शब्द(out_file, "}\n")
            free(name)
        }
        प्रतिफल 1
    }
    
    यदि (tok == 34) { # class
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 14) { next_token(ctx) }
        यदि (read_i64(ctx + 16) == 22) { next_token(ctx) }
        
        मान loop_class_stmts = 1
        जबतक (loop_class_stmts) {
            मान t = read_i64(ctx + 16)
            यदि (t == 23) { loop_class_stmts = 0 }
            यदि (t == 0) { loop_class_stmts = 0 }
            यदि (loop_class_stmts) {
                parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
            }
        }
        यदि (read_i64(ctx + 16) == 23) { next_token(ctx) }
        प्रतिफल 1
    }
    
    यदि (tok == 35) { # public / सार्वजनिक
        next_token(ctx)
        parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
        प्रतिफल 1
    }
    
    यदि (tok == 2) { # Let / मान
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 14) {
            मान name = malloc(256)
            strcpy(name, read_i64(ctx + 24))
            next_token(ctx)
            
            यदि (read_i64(ctx + 16) == 24) { next_token(ctx) }
            मान expr = parse_expr_string(ctx)
            
            # Check if declared
            मान vars_list = read_i64(ctx + 32)
            मान vars_count = read_i64(ctx + 40)
            मान found = 0
            मान idx = 0
            जबतक (idx < vars_count) {
                मान v_name = read_i64(vars_list + idx * 8)
                यदि (strcmp(v_name, name) == 0) {
                    found = 1
                    idx = vars_count
                } अन्यथा {
                    idx = idx + 1
                }
            }
            
            यदि (found) {
                लिखो_शब्द(out_file, name)
                लिखो_शब्द(out_file, " = ")
                लिखो_शब्द(out_file, expr)
                लिखो_शब्द(out_file, ";\n")
            } अन्यथा {
                लिखो_शब्द(out_file, "long long ")
                लिखो_शब्द(out_file, name)
                लिखो_शब्द(out_file, " = ")
                लिखो_शब्द(out_file, expr)
                लिखो_शब्द(out_file, ";\n")
                
                मान name_copy = malloc(strlen(name) + 1)
                strcpy(name_copy, name)
                write_i64(vars_list + vars_count * 8, name_copy)
                write_i64(ctx + 40, vars_count + 1)
            }
            free(name)
            free(expr)
        }
        प्रतिफल 1
    }
    
    यदि (tok == 3) { # If / यदि
        next_token(ctx)
        मान cond = parse_expr_string(ctx)
        यदि (read_i64(ctx + 16) == 22) { next_token(ctx) }
        
        लिखो_शब्द(out_file, "if (")
        लिखो_शब्द(out_file, cond)
        लिखो_शब्द(out_file, ") {\n")
        free(cond)
        
        मान loop_if_stmts = 1
        जबतक (loop_if_stmts) {
            मान t = read_i64(ctx + 16)
            यदि (t == 23) { loop_if_stmts = 0 }
            यदि (t == 0) { loop_if_stmts = 0 }
            यदि (loop_if_stmts) {
                parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
            }
        }
        यदि (read_i64(ctx + 16) == 23) { next_token(ctx) }
        लिखो_शब्द(out_file, "}\n")
        
        यदि (read_i64(ctx + 16) == 4) { # else / अन्यथा
            next_token(ctx)
            यदि (read_i64(ctx + 16) == 22) { next_token(ctx) }
            लिखो_शब्द(out_file, "else {\n")
            
            मान loop_else_stmts = 1
            जबतक (loop_else_stmts) {
                मान t = read_i64(ctx + 16)
                यदि (t == 23) { loop_else_stmts = 0 }
                यदि (t == 0) { loop_else_stmts = 0 }
                यदि (loop_else_stmts) {
                    parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
                }
            }
            यदि (read_i64(ctx + 16) == 23) { next_token(ctx) }
            लिखो_शब्द(out_file, "}\n")
        }
        प्रतिफल 1
    }
    
    यदि (tok == 5) { # While / जबतक
        next_token(ctx)
        मान cond = parse_expr_string(ctx)
        यदि (read_i64(ctx + 16) == 22) { next_token(ctx) }
        
        लिखो_शब्द(out_file, "while (")
        लिखो_शब्द(out_file, cond)
        लिखो_शब्द(out_file, ") {\n")
        free(cond)
        
        मान loop_while_stmts = 1
        जबतक (loop_while_stmts) {
            मान t = read_i64(ctx + 16)
            यदि (t == 23) { loop_while_stmts = 0 }
            यदि (t == 0) { loop_while_stmts = 0 }
            यदि (loop_while_stmts) {
                parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
            }
        }
        यदि (read_i64(ctx + 16) == 23) { next_token(ctx) }
        लिखो_शब्द(out_file, "}\n")
        प्रतिफल 1
    }
    
    यदि (tok == 6) { # Return / प्रतिफल
        next_token(ctx)
        मान expr = parse_expr_string(ctx)
        लिखो_शब्द(out_file, "return ")
        लिखो_शब्द(out_file, expr)
        लिखो_शब्द(out_file, ";\n")
        free(expr)
        प्रतिफल 1
    }
    
    यदि (tok == 7) { # Print / लिखो
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 20) { next_token(ctx) }
        मान expr = parse_expr_string(ctx)
        यदि (read_i64(ctx + 16) == 21) { next_token(ctx) }
        
        # Check if expr starts with '"'
        मान is_str = 0
        यदि (strlen(expr) > 0) {
            यदि (read_byte(expr) == 34) { is_str = 1 }
        }
        
        यदि (is_str) {
            लिखो_शब्द(out_file, "printf(")
            fputc(34, out_file)
            लिखो_शब्द(out_file, "%s\n")
            fputc(34, out_file)
            लिखो_शब्द(out_file, ", ")
            लिखो_शब्द(out_file, expr)
            लिखो_शब्द(out_file, ");\n")
        } अन्यथा {
            लिखो_शब्द(out_file, "printf(")
            fputc(34, out_file)
            लिखो_शब्द(out_file, "%lld\n")
            fputc(34, out_file)
            लिखो_शब्द(out_file, ", ")
            लिखो_शब्द(out_file, expr)
            लिखो_शब्द(out_file, ");\n")
        }
        free(expr)
        प्रतिफल 1
    }
    
    यदि (tok == 38) { # Throw / त्यज
        next_token(ctx)
        मान expr = parse_expr_string(ctx)
        लिखो_शब्द(out_file, "vajra_throw_exception(")
        लिखो_शब्द(out_file, expr)
        लिखो_शब्द(out_file, ");\n")
        free(expr)
        प्रतिफल 1
    }
    
    यदि (tok == 36) { # Try / प्रयत्न
        next_token(ctx)
        यदि (read_i64(ctx + 16) == 22) { next_token(ctx) }
        लिखो_शब्द(out_file, "{\n")
        
        मान loop_try_stmts = 1
        जबतक (loop_try_stmts) {
            मान t = read_i64(ctx + 16)
            यदि (t == 23) { loop_try_stmts = 0 }
            यदि (t == 0) { loop_try_stmts = 0 }
            यदि (loop_try_stmts) {
                parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
            }
        }
        यदि (read_i64(ctx + 16) == 23) { next_token(ctx) }
        लिखो_शब्द(out_file, "}\n")
        
        यदि (read_i64(ctx + 16) == 37) { # catch
            next_token(ctx)
            यदि (read_i64(ctx + 16) == 20) {
                next_token(ctx)
                मान loop_catch_params = 1
                जबतक (loop_catch_params) {
                    मान t = read_i64(ctx + 16)
                    यदि (t == 21) { loop_catch_params = 0 }
                    यदि (t == 0) { loop_catch_params = 0 }
                    यदि (loop_catch_params) { next_token(ctx) }
                }
                next_token(ctx)
            }
            यदि (read_i64(ctx + 16) == 22) {
                next_token(ctx)
                मान brace_count = 1
                मान loop_catch_body = 1
                जबतक (loop_catch_body) {
                    मान t = read_i64(ctx + 16)
                    यदि (t == 0) { loop_catch_body = 0 }
                    यदि (loop_catch_body) {
                        यदि (t == 22) { brace_count = brace_count + 1 }
                        यदि (t == 23) { brace_count = brace_count - 1 }
                        next_token(ctx)
                        यदि (brace_count == 0) { loop_catch_body = 0 }
                    }
                }
            }
        }
        प्रतिफल 1
    }
    
    यदि (tok == 19) { # ';'
        next_token(ctx)
        प्रतिफल 1
    }
    
    # Default expression statement
    मान expr = parse_expr_string(ctx)
    लिखो_शब्द(out_file, expr)
    लिखो_शब्द(out_file, ";\n")
    free(expr)
    प्रतिफल 1
}

कार्या parse_file(path, out_file, parsed_files, parsed_files_count_ptr) {
    मान count = read_i64(parsed_files_count_ptr)
    मान idx = 0
    मान already_parsed = 0
    जबतक (idx < count) {
        मान p_path = read_i64(parsed_files + idx * 8)
        यदि (strcmp(p_path, path) == 0) {
            already_parsed = 1
            idx = count
        } अन्यथा {
            idx = idx + 1
        }
    }
    यदि (already_parsed) {
        प्रतिफल 1
    }

    मान path_copy = malloc(strlen(path) + 1)
    strcpy(path_copy, path)
    write_i64(parsed_files + count * 8, path_copy)
    write_i64(parsed_files_count_ptr, count + 1)

    मान stream = fopen(path, "r")
    यदि (stream == 0) {
        लिखो_शब्द(1, "Error: file not found: ")
        लिखो_शब्द(1, path)
        लिखो_शब्द(1, "\n")
        प्रतिफल 0
    }

    मान ctx = malloc(256)
    write_i64(ctx, stream)
    write_i64(ctx + 8, 0)
    write_i64(ctx + 16, 0)
    write_i64(ctx + 24, 0)
    
    # Initialize vars tracking for this file/scope
    write_i64(ctx + 32, malloc(100 * 8)) # vars_list
    write_i64(ctx + 40, 0) # vars_count
    
    next_char(ctx)
    next_token(ctx)

    मान loop_parse = 1
    जबतक (loop_parse) {
        मान t = read_i64(ctx + 16)
        यदि (t == 0) {
            loop_parse = 0
        } अन्यथा {
            parse_statement(ctx, out_file, parsed_files, parsed_files_count_ptr)
        }
    }

    fclose(stream)
    free(read_i64(ctx + 32))
    मान last_val = read_i64(ctx + 24)
    यदि (last_val) { free(last_val) }
    free(ctx)
    प्रतिफल 1
}

# संकलन समन्वयक (Compilation Coordinator)

कार्या compile_vajra_to_c(source_path, out_c_path) {
    मान out_file = fopen(out_c_path, "w")
    यदि (out_file == 0) {
        लिखो_शब्द(1, "Error: cannot create output C file\n")
        प्रतिफल 0
    }

    # Write runtime header and code directly to C file
    लिखो_शब्द(out_file, "#include <stdio.h>\n")
    लिखो_शब्द(out_file, "#include <stdlib.h>\n")
    लिखो_शब्द(out_file, "#include <string.h>\n")
    लिखो_शब्द(out_file, "#ifdef _WIN32\n")
    लिखो_शब्द(out_file, "#include <windows.h>\n")
    लिखो_शब्द(out_file, "#endif\n\n")

    लिखो_शब्द(out_file, "void* vajra_gc_alloc(size_t size) { return malloc(size); }\n")
    लिखो_शब्द(out_file, "void vajra_gc_free(void* ptr) { free(ptr); }\n")
    लिखो_शब्द(out_file, "void vajra_throw_exception(const char* msg) {\n")
    लिखो_शब्द(out_file, "    fprintf(stderr, ")
    fputc(34, out_file)
    लिखो_शब्द(out_file, "क्रैश! अनपेक्षित अपवाद: %s\n")
    fputc(34, out_file)
    लिखो_शब्द(out_file, ", msg);\n")
    लिखो_शब्द(out_file, "    exit(1);\n")
    लिखो_शब्द(out_file, "}\n")
    लिखो_शब्द(out_file, "void __main(void) {\n")
    लिखो_शब्द(out_file, "#ifdef _WIN32\n")
    लिखो_शब्द(out_file, "    SetConsoleOutputCP(65001);\n")
    लिखो_शब्द(out_file, "#endif\n")
    लिखो_शब्द(out_file, "}\n")
    लिखो_शब्द(out_file, "#ifdef _WIN32\n")
    लिखो_शब्द(out_file, "DWORD WINAPI spawn_thread_proc_helper(LPVOID param) {\n")
    लिखो_शब्द(out_file, "    void (*fn)(void) = (void (*)(void))param;\n")
    लिखो_शब्द(out_file, "    fn();\n")
    लिखो_शब्द(out_file, "    return 0;\n")
    लिखो_शब्द(out_file, "}\n")
    लिखो_शब्द(out_file, "#endif\n")
    लिखो_शब्द(out_file, "void vajra_spawn(void (*fn)(void)) {\n")
    लिखो_शब्द(out_file, "#ifdef _WIN32\n")
    लिखो_शब्द(out_file, "    HANDLE thread = CreateThread(NULL, 0, spawn_thread_proc_helper, (LPVOID)fn, 0, NULL);\n")
    लिखो_शब्द(out_file, "    if (thread != NULL) { CloseHandle(thread); }\n")
    लिखो_शब्द(out_file, "#else\n")
    लिखो_शब्द(out_file, "    fn();\n")
    लिखो_शब्द(out_file, "#endif\n")
    लिखो_शब्द(out_file, "}\n")
    लिखो_शब्द(out_file, "void vajra_parallel_for(long long start, long long end, void (*wf)(long long, long long, long long*, long long), long long* sum, long long nodes) {\n")
    लिखो_शब्द(out_file, "    wf(start, end, sum, nodes);\n")
    लिखो_शब्द(out_file, "}\n\n")

    लिखो_शब्द(out_file, "long long argc = 0;\n")
    लिखो_शब्द(out_file, "char** argv = NULL;\n\n")

    # Pass 1: Forward Declarations
    लिखो_शब्द(1, "Pass 1: Scanning function declarations...\n")
    मान scanned_files = malloc(100 * 8)
    मान scanned_files_count = malloc(8)
    write_i64(scanned_files_count, 0)
    pass1_scan_file(source_path, out_file, scanned_files, scanned_files_count)
    free(scanned_files)
    free(scanned_files_count)

    # Pass 2: Translation
    लिखो_शब्द(1, "Pass 2: Compiling expressions and statements...\n")
    मान parsed_files = malloc(100 * 8)
    मान parsed_files_count = malloc(8)
    write_i64(parsed_files_count, 0)
    parse_file(source_path, out_file, parsed_files, parsed_files_count)
    free(parsed_files)
    free(parsed_files_count)

    # Main Wrapper
    लिखो_शब्द(out_file, "\nint main(int argc_val, char** argv_val) {\n")
    लिखो_शब्द(out_file, "    __main();\n")
    लिखो_शब्द(out_file, "    argc = argc_val;\n")
    लिखो_शब्द(out_file, "    argv = argv_val;\n")
    लिखो_शब्द(out_file, "    मुख्य();\n")
    लिखो_शब्द(out_file, "    return 0;\n")
    लिखो_शब्द(out_file, "}\n")

    fclose(out_file)
    लिखो_शब्द(1, "C code generated successfully.\n")
    प्रतिफल 1
}

# CLI चालक (Driver)

@main
कार्या मुख्य() {
    यदि (argc < 2) {
        लिखो_शब्द(1, "वज्र संकलक v1.0.0 (Vajra Compiler v1.0.0)\n")
        लिखो_शब्द(1, "उपयोग: vajrac <स्रोत_फाइल> [subcommand]\n")
        लिखो_शब्द(1, "सबकमांड: compile, build, run, test\n")
        प्रतिफल 0
    }

    # read argv[1]
    मान arg1 = read_i64(argv + 8)
    
    यदि (strcmp(arg1, "test") == 0) {
        # Running test suite!
        लिखो_शब्द(1, "============================================================\n")
        लिखो_शब्द(1, "Vajra Test Harness: Running self-hosted tests...\n")
        लिखो_शब्द(1, "============================================================\n")
        
        # Windows API FindFirstFileA
        मान find_data = malloc(320)
        मान handle = FindFirstFileA("tests\\*.vj", find_data)
        
        मान no_tests = 0
        यदि (handle == -1) { no_tests = 1 }
        यदि (handle == 0) { no_tests = 1 }
        
        यदि (no_tests) {
            लिखो_शब्द(1, "No tests found in tests/ directory!\n")
            free(find_data)
            प्रतिफल 0
        }
        
        मान passed = 0
        मान total = 0
        
        मान loop_find = 1
        जबतक (loop_find) {
            # filename is at find_data + 44
            मान filename = find_data + 44
            
            लिखो_शब्द(1, "Running test: ")
            लिखो_शब्द(1, filename)
            लिखो_शब्द(1, " ... ")
            
            # Full path: tests\\filename
            मान test_path = malloc(512)
            strcpy(test_path, "tests\\")
            strcat(test_path, filename)
            
            # compile tests to C and build binary
            compile_vajra_to_c(test_path, "temp_test.c")
            
            system("cl.exe /O2 temp_test.c /Fetest_exec.exe /link /nologo > NUL 2> NUL")
            
            # Execute test
            मान status = system("test_exec.exe > test_out.txt 2> NUL")
            यदि (status == 0) {
                लिखो_शब्द(1, "[PASS]\n")
                passed = passed + 1
            } अन्यथा {
                लिखो_शब्द(1, "[FAIL]\n")
            }
            total = total + 1
            
            # cleanup
            system("del temp_test.c test_exec.exe test_exec.obj test_out.txt > NUL 2> NUL")
            free(test_path)
            
            # FindNext
            मान next = FindNextFileA(handle, find_data)
            यदि (next == 0) {
                loop_find = 0
            }
        }
        FindClose(handle)
        free(find_data)
        
        लिखो_शब्द(1, "============================================================\n")
        लिखो_शब्द(1, "Tests completed.\n")
        प्रतिफल 0
    }

    # check if compile subcommand
    मान is_compile = 0
    यदि (strcmp(arg1, "compile") == 0) {
        is_compile = 1
    }
    
    मान is_build = 0
    यदि (strcmp(arg1, "build") == 0) {
        is_build = 1
    }

    मान source_path = arg1
    
    मान need_source = 0
    यदि (is_compile) { need_source = 1 }
    यदि (is_build) { need_source = 1 }
    
    यदि (need_source) {
        यदि (argc < 3) {
            लिखो_शब्द(1, "Error: please specify source file path\n")
            प्रतिफल 1
        }
        source_path = read_i64(argv + 16)
    }

    लिखो_शब्द(1, "Compiling source: ")
    लिखो_शब्द(1, source_path)
    लिखो_शब्द(1, "\n")

    # Generate C code
    compile_vajra_to_c(source_path, "output_temp.c")

    यदि (is_compile) {
        # Compile to object file using cl.exe /c
        system("cl.exe /c /O2 output_temp.c /Fooutput.obj /nologo")
        system("del output_temp.c > NUL 2> NUL")
        लिखो_शब्द(1, "Successfully compiled to output.obj\n")
    } अन्यथा {
        # Build executable
        system("cl.exe /O2 output_temp.c /Fooutput_temp.obj /Feoutput.exe /link /SUBSYSTEM:CONSOLE /nologo")
        system("del output_temp.c output_temp.obj > NUL 2> NUL")
        लिखो_शब्द(1, "Successfully built binary executable output.exe\n")
    }

    प्रतिफल 0
}
