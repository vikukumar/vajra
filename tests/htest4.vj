// Test nested functions and callbacks in Hinglish
@mukhiya
fn shuruat():
    // Nested function test
    karya bahar(val):
        karya andar(x):
            bhejo x * 2
        bhejo andar(val) + 10
    
    dikhao(bahar(5))    // (5*2) + 10 = 20

    // Callback test
    karya lagao(f, v):
        bhejo f(v)

    karya teen_guna(n):
        bhejo n * 3

    dikhao(lagao(teen_guna, 7))   // 21

    // Try/catch
    koshish:
        rakho z = 100 / 5
        dikhao(z)   // 20
    pakdo e:
        bol("pakda!")

    // More fn aliases
    vidhi add(a, b):
        vapas_karo a + b

    dikhao(add(8, 9))   // 17

    tarika mul(a, b):
        wapas a * b

    dikhao(mul(4, 5))   // 20
