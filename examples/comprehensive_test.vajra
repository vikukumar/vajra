// Multi-language test: Hindi, Sanskrit, and English together
// हिंदी, संस्कृत, और English में एक साथ

fn fibonacci(n) {
    if (n <= 1) {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn is_prime(n) {
    if (n < 2) { return false }
    let i = 2
    while (i * i <= n) {
        if (n % i == 0) { return false }
        i = i + 1
    }
    return true
}

@main
fn main() {
    // English output
    print("=== Vajra v0.2 — Self-Hosted Language ===")
    print("No GCC, No LLVM, No MSVC, No Clang!")
    print("")
    
    // Fibonacci sequence
    print("Fibonacci sequence:")
    let i = 0
    while (i < 10) {
        print(fibonacci(i))
        i = i + 1
    }
    
    // Prime numbers
    print("")
    print("Primes 1-20:")
    let n = 2
    while (n <= 20) {
        if (is_prime(n)) {
            print(n)
        }
        n = n + 1
    }
    
    // Math
    print("")
    print("Math: 2^10 = " + str(1024))
    print("Pi ≈ 3.14159")
    
    print("")
    print("✅ Vajra compiler test: PASSED")
    print("Supports: English, हिंदी, संस्कृत, தமிழ், العربية, 中文, Español")
}
