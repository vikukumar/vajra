# Vajra Stage 1 Integrated Package & Manifest Parser (v1.0.0)
# Written entirely in high-performance Vajra syntax (.vj)

@extern
fn strcmp(s1, s2)

@extern
fn strlen(s)

@extern
fn get_char(s, i)

@extern
fn substring(s, start, end)

# Helper to check if character is a digit
fn manifest_is_digit(c) {
    if strcmp(c, "0") == 0 { return true }
    if strcmp(c, "1") == 0 { return true }
    if strcmp(c, "2") == 0 { return true }
    if strcmp(c, "3") == 0 { return true }
    if strcmp(c, "4") == 0 { return true }
    if strcmp(c, "5") == 0 { return true }
    if strcmp(c, "6") == 0 { return true }
    if strcmp(c, "7") == 0 { return true }
    if strcmp(c, "8") == 0 { return true }
    if strcmp(c, "9") == 0 { return true }
    return false
}

# Helper to strip leading and trailing whitespace
fn strip_whitespace(s) {
    var start = 0
    var end = strlen(s)
    
    var loop_cond = true
    while loop_cond {
        if start < end {
            var c = get_char(s, start)
            if strcmp(c, " ") == 0 {
                start = start + 1
            } else {
                if strcmp(c, "\n") == 0 {
                    start = start + 1
                } else {
                    if strcmp(c, "\r") == 0 {
                        start = start + 1
                    } else {
                        if strcmp(c, "\t") == 0 {
                            start = start + 1
                        } else {
                            loop_cond = false
                        }
                    }
                }
            }
        } else {
            loop_cond = false
        }
    }
    
    var loop_cond2 = true
    while loop_cond2 {
        if end > start {
            var c = get_char(s, end - 1)
            if strcmp(c, " ") == 0 {
                end = end - 1
            } else {
                if strcmp(c, "\n") == 0 {
                    end = end - 1
                } else {
                    if strcmp(c, "\r") == 0 {
                        end = end - 1
                    } else {
                        if strcmp(c, "\t") == 0 {
                            end = end - 1
                        } else {
                            loop_cond2 = false
                        }
                    }
                }
            }
        } else {
            loop_cond2 = false
        }
    }
    
    return substring(s, start, end)
}

# Natively parses simple JSON files
fn parse_json(content, quote) {
    var len = strlen(content)
    var idx = 0
    
    while idx < len {
        if strcmp(get_char(content, idx), quote) == 0 {
            idx = idx + 1
            var key_start = idx
            
            var inner_cond = true
            while inner_cond {
                if idx < len {
                    if strcmp(get_char(content, idx), quote) == 0 {
                        inner_cond = false
                    } else {
                        idx = idx + 1
                    }
                } else {
                    inner_cond = false
                }
            }
            
            var key = substring(content, key_start, idx)
            idx = idx + 1 # skip closing quote
            
            # Skip to colon
            var inner_cond2 = true
            while inner_cond2 {
                if idx < len {
                    if strcmp(get_char(content, idx), ":") == 0 {
                        inner_cond2 = false
                    } else {
                        idx = idx + 1
                    }
                } else {
                    inner_cond2 = false
                }
            }
            idx = idx + 1 # skip colon
            
            # Skip spaces
            var inner_cond3 = true
            while inner_cond3 {
                if idx < len {
                    var c = get_char(content, idx)
                    if strcmp(c, " ") == 0 {
                        idx = idx + 1
                    } else {
                        if strcmp(c, "\t") == 0 {
                            idx = idx + 1
                        } else {
                            if strcmp(c, "\n" ) == 0 {
                                idx = idx + 1
                            } else {
                                if strcmp(c, "\r") == 0 {
                                    idx = idx + 1
                                } else {
                                    inner_cond3 = false
                                }
                            }
                        }
                    }
                } else {
                    inner_cond3 = false
                }
            }
            
            if strcmp(get_char(content, idx), quote) == 0 {
                idx = idx + 1
                var val_start = idx
                
                var inner_cond4 = true
                while inner_cond4 {
                    if idx < len {
                        if strcmp(get_char(content, idx), quote) == 0 {
                            inner_cond4 = false
                        } else {
                            idx = idx + 1
                        }
                    } else {
                        inner_cond4 = false
                    }
                }
                
                var val = substring(content, val_start, idx)
                idx = idx + 1 # skip quote
                
                # Expose metadata via simple prints or returns
                print(key, val)
            }
        } else {
            idx = idx + 1
        }
    }
}

# Natively parses simple YAML files
fn parse_yaml(content, quote) {
    var len = strlen(content)
    var idx = 0
    
    while idx < len {
        var line_start = idx
        
        var inner_cond5 = true
        while inner_cond5 {
            if idx < len {
                if strcmp(get_char(content, idx), "\n") == 0 {
                    inner_cond5 = false
                } else {
                    idx = idx + 1
                }
            } else {
                inner_cond5 = false
            }
        }
        
        var line = substring(content, line_start, idx)
        idx = idx + 1 # skip newline
        
        var colon_idx = -1
        var jdx = 0
        var line_len = strlen(line)
        while jdx < line_len {
            if strcmp(get_char(line, jdx), ":") == 0 {
                colon_idx = jdx
                jdx = line_len # break
            } else {
                jdx = jdx + 1
            }
        }
        
        if colon_idx == -1 {
            # do nothing
        } else {
            var raw_key = substring(line, 0, colon_idx)
            var raw_val = substring(line, colon_idx + 1, line_len)
            
            var key = strip_whitespace(raw_key)
            var val = strip_whitespace(raw_val)
            
            # Strip quotes if present
            if strlen(val) > 1 {
                if strcmp(get_char(val, 0), quote) == 0 {
                    if strcmp(get_char(val, strlen(val) - 1), quote) == 0 {
                        val = substring(val, 1, strlen(val) - 1)
                    }
                }
            }
            
            # Expose metadata via simple prints or returns
            print(key, val)
        }
    }
}

# Auto-detector entry point
fn load_project_manifest(filepath, content) {
    # Extract double quote char dynamically from content!
    var quote = ""
    var len = strlen(content)
    var idx = 0
    var loop_find = true
    while loop_find {
        if idx < len {
            var c = get_char(content, idx)
            if strcmp(c, "{") == 0 {
                idx = idx + 1
            } else {
                if strcmp(c, " ") == 0 {
                    idx = idx + 1
                } else {
                    if strcmp(c, "\n") == 0 {
                        idx = idx + 1
                    } else {
                        if strcmp(c, "\r") == 0 {
                            idx = idx + 1
                        } else {
                            if strcmp(c, "\t") == 0 {
                                idx = idx + 1
                            } else {
                                quote = c
                                loop_find = false
                            }
                        }
                    }
                }
            }
        } else {
            loop_find = false
        }
    }

    # Check if JSON or YAML based on extension or signature
    var is_yaml = false
    var filepath_len = strlen(filepath)
    
    if filepath_len > 4 {
        if strcmp(substring(filepath, filepath_len - 5, filepath_len), ".yaml") == 0 {
            is_yaml = true
        }
    }
    if filepath_len > 3 {
        if strcmp(substring(filepath, filepath_len - 4, filepath_len), ".yml") == 0 {
            is_yaml = true
        }
    }
    
    if is_yaml {
        parse_yaml(content, quote)
    } else {
        parse_json(content, quote)
    }
}
