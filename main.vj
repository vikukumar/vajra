# Vajra Stage 1 Self-Hosted Compiler Orchestrator (v1.0.0)
# Written entirely in high-performance Vajra syntax (.vj)

@extern
fn strcmp(s1, s2)

@extern
fn get_char(s, i)

@extern
fn printf(fmt, arg)

@extern
fn get_argv_item(argv, idx)

@extern
fn read_file_content(path)

@extern
fn write_file_content(path, content)

@extern
fn create_parser_state(content)

@extern
fn parse_program(state)

@extern
fn cg_new(target)

@extern
fn compile_node(cg_state, ast, quote)

@extern
fn cg_get_ir(cg_state)

@extern
fn system(cmd)

@extern
fn get_quote_char()

@main
fn compile_main() {
    if argc == 1 {
        printf("Vajra Stage 1 Self-Hosted Compiler v1.0.0\n", 0)
        printf("Usage: vajrac.exe <source_file.vj>\n", 0)
        return 0
    }
    
    var source_path = get_argv_item(argv, 1)
    printf("Reading source file: %s\n", source_path)
    
    var content = read_file_content(source_path)
    if strcmp(content, "") == 0 {
        printf("Error: Could not read source file or file is empty.\n", 0)
        return 1
    }
    
    printf("Parsing source code...\n", 0)
    var parser_state = create_parser_state(content)
    var ast = parse_program(parser_state)
    
    printf("Generating multi-platform LLVM IR...\n", 0)
    var quote = get_quote_char()
    var cg_state = cg_new("windows")
    compile_node(cg_state, ast, quote)
    var ir = cg_get_ir(cg_state)
    
    var ir_path = "temp_output.ll"
    printf("Writing LLVM IR to temporary file: %s\n", ir_path)
    write_file_content(ir_path, ir)
    
    printf("Invoking LLVM Static Compiler (llc) to compile LLVM IR to native object code...\n", 0)
    
    var llc_cmd = "C:\\mingw64\\bin\\llc.exe -filetype=obj -o output_stage1.o temp_output.ll"
    system(llc_cmd)
    
    printf("Compilation successful! Native machine object code saved to: output_stage1.o\n", 0)
    return 0
}
