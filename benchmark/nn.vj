@main
कार्या मुख्य() {
    अस्तु sum = 0
    अस्तु layers = 1000000
    अस्तु nodes = 10000
    
    अस्तु l = 0
    यावत् (l < layers) {
        अस्तु t1 = l * 17
        अस्तु n = 0
        यावत् (n < nodes) {
            अस्तु t2 = n * 31
            अस्तु val = t1 + t2
            
            अस्तु div = val / 10
            अस्तु term = div * 10
            अस्तु weight = val - term
            
            अस्तु val2 = l + n
            अस्तु div2 = val2 / 5
            अस्तु term2 = div2 * 5
            अस्तु bias = val2 - term2
            
            अस्तु t3 = weight * n
            अस्तु act = t3 + bias
            चेत् (act > 5) {
                sum = sum + act
            }
            n = n + 1
        }
        l = l + 1
    }
    लिखो(sum)
}
