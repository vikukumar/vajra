# Vajra Stage 1 Unified Polyglot Parser (v1.0.0)
# Written entirely in high-performance Vajra syntax (.vj)

@extern
fn strcmp(s1, s2)

@extern
fn strlen(s)

@extern
fn get_char(s, i)

@extern
fn substring(s, start, end)

@extern
fn ast_new()

@extern
fn ast_set_type(node, type_str)

@extern
fn ast_get_type(node)

@extern
fn ast_set_name(node, name_str)

@extern
fn ast_get_name(node)

@extern
fn ast_set_value(node, val_str)

@extern
fn ast_get_value(node)

@extern
fn ast_set_op(node, op_str)

@extern
fn ast_get_op(node)

@extern
fn ast_set_left(node, left_node)

@extern
fn ast_get_left(node)

@extern
fn ast_set_right(node, right_node)

@extern
fn ast_get_right(node)

@extern
fn ast_push_param(node, param_str)

@extern
fn ast_push_body(node, body_node)

@extern
fn ast_push_arg(node, arg_node)

@extern
fn parser_get_cur_kind(state)

@extern
fn parser_get_cur_val(state)

@extern
fn parser_get_peek_kind(state)

@extern
fn parser_get_peek_val(state)

@extern
fn parser_advance(state)

# Skips newline tokens
fn parser_skip_newlines(state) {
    var loop_cond = true
    while loop_cond {
        if parser_get_cur_kind(state) == 2 { # 2 = Newline
            parser_advance(state)
        } else {
            loop_cond = false
        }
    }
}

# Recursively parses expressions
fn parse_expression(state) {
    parser_skip_newlines(state)
    
    var left = 0
    var kind = parser_get_cur_kind(state)
    var val = parser_get_cur_val(state)
    
    if kind == 4 { # Number
        left = ast_new()
        ast_set_type(left, "Literal")
        ast_set_value(left, val)
        parser_advance(state)
    } else {
        if kind == 3 { # String
            left = ast_new()
            ast_set_type(left, "Literal")
            ast_set_value(left, val)
            parser_advance(state)
        } else {
            if kind == 5 { # Identifier
                left = ast_new()
                ast_set_type(left, "Identifier")
                ast_set_name(left, val)
                parser_advance(state)
            } else {
                if kind == 27 { # True
                    left = ast_new()
                    ast_set_type(left, "Literal")
                    ast_set_value(left, val)
                    parser_advance(state)
                } else {
                    if kind == 28 { # False
                        left = ast_new()
                        ast_set_type(left, "Literal")
                        ast_set_value(left, val)
                        parser_advance(state)
                    } else {
                        if kind == 29 { # Null
                            left = ast_new()
                            ast_set_type(left, "Literal")
                            ast_set_value(left, val)
                            parser_advance(state)
                        } else {
                            if kind == 25 { # New
                                parser_advance(state)
                                left = parse_expression(state)
                            } else {
                                if kind == 24 { # Await
                                    parser_advance(state)
                                    left = parse_expression(state)
                                } else {
                                    if kind == 26 { # This
                                        left = ast_new()
                                        ast_set_type(left, "Identifier")
                                        ast_set_name(left, "this")
                                        parser_advance(state)
                                    } else {
                                        if kind == 31 { # LParen
                                            parser_advance(state) # skip '('
                                            left = parse_expression(state)
                                            if parser_get_cur_kind(state) == 32 { # RParen
                                                parser_advance(state) # skip ')'
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    # Precedence climbing and infix parsing
    var loop_cond2 = true
    while loop_cond2 {
        var curr_kind = parser_get_cur_kind(state)
        if curr_kind == 37 { loop_cond2 = false } # Semicolon
        if curr_kind == 2 { loop_cond2 = false } # Newline
        if curr_kind == 1 { loop_cond2 = false } # EOF
        if curr_kind == 34 { loop_cond2 = false } # RBrace
        if curr_kind == 32 { loop_cond2 = false } # RParen
        
        if loop_cond2 {
            var curr_val = parser_get_cur_val(state)
            
            # Binary Operators (Plus, Minus, Star, Slash, Equal, Less, Greater, LessEqual, GreaterEqual)
            var is_binop = false
            if curr_kind == 41 { is_binop = true } # Plus
            if curr_kind == 42 { is_binop = true } # Minus
            if curr_kind == 43 { is_binop = true } # Star
            if curr_kind == 44 { is_binop = true } # Slash
            if curr_kind == 47 { is_binop = true } # Equal
            if curr_kind == 45 { is_binop = true } # Less
            if curr_kind == 46 { is_binop = true } # Greater
            if curr_kind == 48 { is_binop = true } # LessEqual
            if curr_kind == 49 { is_binop = true } # GreaterEqual
            
            if is_binop {
                parser_advance(state)
                var right = parse_expression(state)
                var parent = ast_new()
                ast_set_type(parent, "BinaryOp")
                ast_set_op(parent, curr_val)
                ast_set_left(parent, left)
                ast_set_right(parent, right)
                left = parent
            } else {
                if curr_kind == 39 { # Dot Property Access or Method Call
                    parser_advance(state) # skip '.'
                    var prop_name = parser_get_cur_val(state)
                    parser_advance(state) # skip prop identifier
                    
                    if parser_get_cur_kind(state) == 31 { # LParen (Method Call)
                        parser_advance(state) # skip '('
                        var method_node = ast_new()
                        ast_set_type(method_node, "MethodCall")
                        ast_set_name(method_node, prop_name)
                        ast_set_left(method_node, left)
                        
                        var inner_cond = true
                        while inner_cond {
                            if parser_get_cur_kind(state) == 32 { # RParen
                                inner_cond = false
                            } else {
                                if parser_get_cur_kind(state) == 1 { # EOF
                                    inner_cond = false
                                } else {
                                    var arg = parse_expression(state)
                                    ast_push_arg(method_node, arg)
                                    if parser_get_cur_kind(state) == 38 { # Comma
                                        parser_advance(state)
                                    }
                                }
                            }
                        }
                        parser_advance(state) # skip ')'
                        left = method_node
                    } else {
                        var prop_node = ast_new()
                        ast_set_type(prop_node, "PropertyAccess")
                        ast_set_left(prop_node, left)
                        ast_set_op(prop_node, prop_name)
                        left = prop_node
                    }
                } else {
                    if curr_kind == 31 { # LParen (Function Call)
                        parser_advance(state) # skip '('
                        var call_node = ast_new()
                        ast_set_type(call_node, "FunctionCall")
                        ast_set_name(call_node, ast_get_name(left))
                        
                        var inner_cond2 = true
                        while inner_cond2 {
                            if parser_get_cur_kind(state) == 32 { # RParen
                                inner_cond2 = false
                            } else {
                                if parser_get_cur_kind(state) == 1 { # EOF
                                    inner_cond2 = false
                                } else {
                                    var arg = parse_expression(state)
                                    ast_push_arg(call_node, arg)
                                    if parser_get_cur_kind(state) == 38 { # Comma
                                        parser_advance(state)
                                    }
                                }
                            }
                        }
                        parser_advance(state) # skip ')'
                        left = call_node
                    } else {
                        parser_advance(state) # Safety increment to prevent infinite loops
                    }
                }
            }
        }
    }
    return left
}

# Parses single statements
fn parse_statement(state) {
    parser_skip_newlines(state)
    var kind = parser_get_cur_kind(state)
    
    if kind == 6 { # Let / Const / Var
        parser_advance(state)
        var name = parser_get_cur_val(state)
        parser_advance(state)
        
        var val = 0
        if parser_get_cur_kind(state) == 40 { # Assign (=)
            parser_advance(state)
            val = parse_expression(state)
        }
        
        var node = ast_new()
        ast_set_type(node, "Let")
        ast_set_name(node, name)
        ast_set_left(node, val)
        return node
    }
    
    if kind == 50 { # Function Definition
        parser_advance(state)
        var name = parser_get_cur_val(state)
        parser_advance(state)
        
        var node = ast_new()
        ast_set_type(node, "Function")
        ast_set_name(node, name)
        
        if parser_get_cur_kind(state) == 31 { # LParen
            parser_advance(state)
            var inner_cond = true
            while inner_cond {
                if parser_get_cur_kind(state) == 32 { # RParen
                    inner_cond = false
                } else {
                    if parser_get_cur_kind(state) == 1 { # EOF
                        inner_cond = false
                    } else {
                        ast_push_param(node, parser_get_cur_val(state))
                        parser_advance(state)
                        if parser_get_cur_kind(state) == 38 { # Comma
                            parser_advance(state)
                        }
                    }
                }
            }
            parser_advance(state) # skip ')'
        }
        
        parser_skip_newlines(state)
        
        if parser_get_cur_kind(state) == 33 { # LBrace
            parser_advance(state)
            var inner_cond2 = true
            while inner_cond2 {
                if parser_get_cur_kind(state) == 34 { # RBrace
                    inner_cond2 = false
                } else {
                    if parser_get_cur_kind(state) == 1 { # EOF
                        inner_cond2 = false
                    } else {
                        var stmt = parse_statement(state)
                        if stmt == 0 {
                            # do nothing
                        } else {
                            ast_push_body(node, stmt)
                        }
                    }
                }
            }
            parser_advance(state) # skip '}'
        }
        return node
    }
    
    if kind == 7 { # Class Definition
        parser_advance(state)
        var name = parser_get_cur_val(state)
        parser_advance(state)
        
        var node = ast_new()
        ast_set_type(node, "Class")
        ast_set_name(node, name)
        
        parser_skip_newlines(state)
        
        if parser_get_cur_kind(state) == 33 { # LBrace
            parser_advance(state)
            var inner_cond = true
            while inner_cond {
                if parser_get_cur_kind(state) == 34 { # RBrace
                    inner_cond = false
                } else {
                    if parser_get_cur_kind(state) == 1 { # EOF
                        inner_cond = false
                    } else {
                        var stmt = parse_statement(state)
                        if stmt == 0 {
                            # do nothing
                        } else {
                            ast_push_body(node, stmt)
                        }
                    }
                }
            }
            parser_advance(state) # skip '}'
        }
        return node
    }
    
    if kind == 14 { # While Loop
        parser_advance(state)
        var has_paren = false
        if parser_get_cur_kind(state) == 31 {
            has_paren = true
            parser_advance(state)
        }
        
        var cond = parse_expression(state)
        if has_paren {
            if parser_get_cur_kind(state) == 32 {
                parser_advance(state)
            }
        }
        
        var node = ast_new()
        ast_set_type(node, "While")
        ast_set_left(node, cond)
        
        parser_skip_newlines(state)
        
        if parser_get_cur_kind(state) == 33 { # LBrace
            parser_advance(state)
            var inner_cond = true
            while inner_cond {
                if parser_get_cur_kind(state) == 34 { # RBrace
                    inner_cond = false
                } else {
                    if parser_get_cur_kind(state) == 1 { # EOF
                        inner_cond = false
                    } else {
                        var stmt = parse_statement(state)
                        if stmt == 0 {
                            # do nothing
                        } else {
                            ast_push_body(node, stmt)
                        }
                    }
                }
            }
            parser_advance(state)
        }
        return node
    }
    
    if kind == 19 { # For Loop
        parser_advance(state)
        var has_paren = false
        if parser_get_cur_kind(state) == 31 {
            has_paren = true
            parser_advance(state)
        }
        
        var loop_var = parser_get_cur_val(state)
        parser_advance(state) # skip loop var identifier
        
        parser_advance(state) # skip 'in' keyword
        var iterable = parse_expression(state)
        
        if has_paren {
            if parser_get_cur_kind(state) == 32 {
                parser_advance(state)
            }
        }
        
        var node = ast_new()
        ast_set_type(node, "For")
        ast_set_name(node, loop_var)
        ast_set_left(node, iterable)
        
        parser_skip_newlines(state)
        
        if parser_get_cur_kind(state) == 33 { # LBrace
            parser_advance(state)
            var inner_cond = true
            while inner_cond {
                if parser_get_cur_kind(state) == 34 { # RBrace
                    inner_cond = false
                } else {
                    if parser_get_cur_kind(state) == 1 { # EOF
                        inner_cond = false
                    } else {
                        var stmt = parse_statement(state)
                        if stmt == 0 {
                            # do nothing
                        } else {
                            ast_push_body(node, stmt)
                        }
                    }
                }
            }
            parser_advance(state)
        }
        return node
    }
    
    if kind == 30 { # Spawn call
        parser_advance(state)
        var expr = parse_expression(state)
        var node = ast_new()
        ast_set_type(node, "SpawnCall")
        ast_set_left(node, expr)
        return node
    }
    
    # Semicolons, Newlines, EOF are skipped
    var is_skip = false
    if kind == 2 { is_skip = true }
    if kind == 37 { is_skip = true }
    if kind == 1 { is_skip = true }
    
    if is_skip {
        parser_advance(state)
        return 0
    }
    
    # Expression Statement
    var expr = parse_expression(state)
    var node = ast_new()
    ast_set_type(node, "ExpressionStatement")
    ast_set_left(node, expr)
    return node
}

# Entrypoint to parse the full program
fn parse_program(state) {
    var prog = ast_new()
    ast_set_type(prog, "Program")
    
    var loop_cond = true
    while loop_cond {
        if parser_get_cur_kind(state) == 1 { # EOF
            loop_cond = false
        } else {
            var stmt = parse_statement(state)
            if stmt == 0 {
                # do nothing
            } else {
                ast_push_body(prog, stmt)
            }
        }
    }
    return prog
}
