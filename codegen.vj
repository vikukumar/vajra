# Vajra Stage 1 Multi-Platform LLVM & Concurrency Code Generator (v1.0.0)
# Written entirely in high-performance Vajra syntax (.vj)

@extern
fn strcmp(s1, s2)

@extern
fn strlen(s)

@extern
fn get_char(s, i)

@extern
fn substring(s, start, end)

@extern
fn concat2(s1, s2)

@extern
fn concat3(s1, s2, s3)

@extern
fn concat4(s1, s2, s3, s4)

@extern
fn concat5(s1, s2, s3, s4, s5)

@extern
fn ast_new()

@extern
fn ast_get_type(node)

@extern
fn ast_get_name(node)

@extern
fn ast_get_value(node)

@extern
fn ast_get_op(node)

@extern
fn ast_get_left(node)

@extern
fn ast_get_right(node)

@extern
fn ast_get_body_size(node)

@extern
fn ast_get_body_item(node, idx)

@extern
fn ast_get_args_size(node)

@extern
fn ast_get_args_item(node, idx)

@extern
fn cg_emit(state, line)

@extern
fn cg_emit_global(state, line)

@extern
fn cg_next_var(state)

@extern
fn cg_next_label(state, prefix)

@extern
fn cg_get_target_platform(state)

@extern
fn get_newline_char()

# Core LLVM Target triple mapping for Windows, Linux, Mac, Android, and iOS
fn emit_platform_target_header(state, quote) {
    var platform = cg_get_target_platform(state)
    var header = ""
    var nl = get_newline_char()
    var nl_triple = concat2(nl, "target triple = ")
    
    if strcmp(platform, "windows") == 0 {
        var h1 = concat5("target datalayout = ", quote, "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128", quote, nl_triple)
        var h2 = concat2(quote, "x86_64-pc-windows-msvc")
        var h3 = concat2(h2, quote)
        header = concat2(h1, h3)
    } else {
        if strcmp(platform, "linux") == 0 {
            var h1 = concat5("target datalayout = ", quote, "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128", quote, nl_triple)
            var h2 = concat2(quote, "x86_64-unknown-linux-gnu")
            var h3 = concat2(h2, quote)
            header = concat2(h1, h3)
        } else {
            if strcmp(platform, "macos") == 0 {
                var h1 = concat5("target datalayout = ", quote, "e-m:o-i64:64-i128:128-n32:64-S128", quote, nl_triple)
                var h2 = concat2(quote, "x86_64-apple-macosx10.15.0")
                var h3 = concat2(h2, quote)
                header = concat2(h1, h3)
            } else {
                if strcmp(platform, "android") == 0 {
                    var h1 = concat5("target datalayout = ", quote, "e-m:e-i64:64-i128:128-n32:64-S128", quote, nl_triple)
                    var h2 = concat2(quote, "aarch64-none-linux-android")
                    var h3 = concat2(h2, quote)
                    header = concat2(h1, h3)
                } else {
                    if strcmp(platform, "ios") == 0 {
                        var h1 = concat5("target datalayout = ", quote, "e-m:o-i64:64-i128:128-n32:64-S128", quote, nl_triple)
                        var h2 = concat2(quote, "arm64-apple-ios14.0")
                        var h3 = concat2(h2, quote)
                        header = concat2(h1, h3)
                    }
                }
            }
        }
    }
    
    var nl2 = concat2(nl, nl)
    
    # Declare GIL-free lock-free work-stealing concurrency runtime stubs
    var stub1 = concat2(nl2, "; GIL-free native multitasking & thread spawn stubs\ndeclare void @vajra_spawn(void ()*)\ndeclare void @vajra_parallel_for(i64, i64, void (i64, i64, i64*, i64)*, i64*, i64)")
    header = concat2(header, stub1)
    
    # Declare Low-latency Concurrent GC hooks
    var stub2 = concat2(nl2, "; Low-latency concurrent GC allocator & free hooks\ndeclare i8* @vajra_gc_alloc(i64)\ndeclare void @vajra_gc_free(i8*)")
    header = concat2(header, stub2)
    
    # Expose high-speed AVX-512 SIMD first-class vector operators
    var stub3 = concat2(nl2, "; Native SIMD/AVX-512 assembly tensor intrinsics\ndeclare <8 x double> @llvm.x86.avx512.mask.add.pd.512(<8 x double>, <8 x double>, <8 x double>, i8, i32)")
    header = concat2(header, stub3)
    
    cg_emit_global(state, header)
}

# Recursively compiles AST nodes to LLVM IR
fn compile_node(state, node, quote) {
    var type = ast_get_type(node)
    
    if strcmp(type, "Literal") == 0 {
        return ast_get_value(node)
    }
    
    if strcmp(type, "Identifier") == 0 {
        var out_var = cg_next_var(state)
        cg_emit(state, concat3(out_var, " = load i64, i64* %", ast_get_name(node)))
        return out_var
    }
    
    if strcmp(type, "Let") == 0 {
        cg_emit(state, concat3("%", ast_get_name(node), " = alloca i64"))
        var left = ast_get_left(node)
        if left == 0 {
            # do nothing
        } else {
            var val_var = compile_node(state, left, quote)
            cg_emit(state, concat4("store i64 ", val_var, ", i64* %", ast_get_name(node)))
        }
        return ""
    }
    
    if strcmp(type, "BinaryOp") == 0 {
        var lhs = compile_node(state, ast_get_left(node), quote)
        var rhs = compile_node(state, ast_get_right(node), quote)
        var op = ast_get_op(node)
        var out_var = cg_next_var(state)
        
        if strcmp(op, "+") == 0 {
            cg_emit(state, concat5(out_var, " = add nsw i64 ", lhs, ", ", rhs))
        } else {
            if strcmp(op, "-") == 0 {
                cg_emit(state, concat5(out_var, " = sub nsw i64 ", lhs, ", ", rhs))
            } else {
                if strcmp(op, "*") == 0 {
                    cg_emit(state, concat5(out_var, " = mul nsw i64 ", lhs, ", ", rhs))
                } else {
                    if strcmp(op, "/") == 0 {
                        cg_emit(state, concat5(out_var, " = sdiv i64 ", lhs, ", ", rhs))
                    } else {
                        if strcmp(op, "<") == 0 {
                            var cmp_var = cg_next_var(state)
                            cg_emit(state, concat5(cmp_var, " = icmp slt i64 ", lhs, ", ", rhs))
                            cg_emit(state, concat3(out_var, " = zext i1 ", concat2(cmp_var, " to i64")))
                        } else {
                            if strcmp(op, ">") == 0 {
                                var cmp_var = cg_next_var(state)
                                cg_emit(state, concat5(cmp_var, " = icmp sgt i64 ", lhs, ", ", rhs))
                                cg_emit(state, concat3(out_var, " = zext i1 ", concat2(cmp_var, " to i64")))
                            }
                        }
                    }
                }
            }
        }
        return out_var
    }
    
    if strcmp(type, "While") == 0 {
        var cond_lbl = cg_next_label(state, "while_cond")
        var body_lbl = cg_next_label(state, "while_body")
        var end_lbl = cg_next_label(state, "while_end")
        
        cg_emit(state, concat2("br label %", cond_lbl))
        cg_emit(state, concat2(cond_lbl, ":"))
        
        var cond_val = compile_node(state, ast_get_left(node), quote)
        var cmp_var = cg_next_var(state)
        cg_emit(state, concat4(cmp_var, " = icmp ne i64 ", cond_val, ", 0"))
        cg_emit(state, concat5("br i1 ", cmp_var, " label %", body_lbl, concat2(" label %", end_lbl)))
        
        cg_emit(state, concat2(body_lbl, ":"))
        
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            compile_node(state, ast_get_body_item(node, idx), quote)
            idx = idx + 1
        }
        cg_emit(state, concat2("br label %", cond_lbl))
        cg_emit(state, concat2(end_lbl, ":"))
        return ""
    }
    
    if strcmp(type, "For") == 0 {
        cg_emit(state, concat3("%", ast_get_name(node), " = alloca i64"))
        cg_emit(state, concat2("store i64 0, i64* %", ast_get_name(node)))
        
        var cond_lbl = cg_next_label(state, "for_cond")
        var body_lbl = cg_next_label(state, "for_body")
        var end_lbl = cg_next_label(state, "for_end")
        
        cg_emit(state, concat2("br label %", cond_lbl))
        cg_emit(state, concat2(cond_lbl, ":"))
        
        var loop_var_val = cg_next_var(state)
        cg_emit(state, concat3(loop_var_val, " = load i64, i64* %", ast_get_name(node)))
        
        var iter_val = compile_node(state, ast_get_left(node), quote)
        var cmp_var = cg_next_var(state)
        cg_emit(state, concat5(cmp_var, " = icmp slt i64 ", loop_var_val, ", ", iter_val))
        cg_emit(state, concat5("br i1 ", cmp_var, " label %", body_lbl, concat2(" label %", end_lbl)))
        
        cg_emit(state, concat2(body_lbl, ":"))
        
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            compile_node(state, ast_get_body_item(node, idx), quote)
            idx = idx + 1
        }
        
        var cur_loop_val = cg_next_var(state)
        cg_emit(state, concat3(cur_loop_val, " = load i64, i64* %", ast_get_name(node)))
        var inc_val = cg_next_var(state)
        cg_emit(state, concat3(inc_val, " = add nsw i64 ", concat2(cur_loop_val, ", 1")))
        cg_emit(state, concat4("store i64 ", inc_val, ", i64* %", ast_get_name(node)))
        cg_emit(state, concat2("br label %", cond_lbl))
        cg_emit(state, concat2(end_lbl, ":"))
        return ""
    }
    
    if strcmp(type, "SpawnCall") == 0 {
        var func_name = ast_get_name(ast_get_left(node))
        cg_emit(state, concat3("call void @vajra_spawn(void ()* @", func_name, ")"))
        return ""
    }
    
    if strcmp(type, "PrintCall") == 0 {
        var idx = 0
        var len = ast_get_args_size(node)
        while idx < len {
            var arg_val = compile_node(state, ast_get_args_item(node, idx), quote)
            cg_emit(state, concat3("call void @print_i64(i64 ", arg_val, ")"))
            idx = idx + 1
        }
        return ""
    }
    
    if strcmp(type, "FunctionCall") == 0 {
        var func_name = ast_get_name(node)
        
        # Build the arguments list
        var args_str = ""
        var idx = 0
        var len = ast_get_args_size(node)
        while idx < len {
            var arg_node = ast_get_args_item(node, idx)
            var arg_val = compile_node(state, arg_node, quote)
            if idx == 0 {
                args_str = concat2("i64 ", arg_val)
            } else {
                args_str = concat3(args_str, ", i64 ", arg_val)
            }
            idx = idx + 1
        }
        
        var out_var = cg_next_var(state)
        cg_emit(state, concat5(out_var, " = call i64 @", func_name, "(", concat2(args_str, ")")))
        return out_var
    }
    
    if strcmp(type, "Function") == 0 {
        cg_emit(state, concat3("define void @", ast_get_name(node), "() {"))
        
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            compile_node(state, ast_get_body_item(node, idx), quote)
            idx = idx + 1
        }
        
        cg_emit(state, "ret void")
        cg_emit(state, "}")
        return ""
    }
    
    if strcmp(type, "Class") == 0 {
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            compile_node(state, ast_get_body_item(node, idx), quote)
            idx = idx + 1
        }
        return ""
    }
    
    if strcmp(type, "Program") == 0 {
        emit_platform_target_header(state, quote)
        
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            compile_node(state, ast_get_body_item(node, idx), quote)
            idx = idx + 1
        }
        return ""
    }
    
    return ""
}
