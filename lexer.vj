# Vajra Stage 1 Universal Polyglot Lexer (v1.0.0)
# Written entirely in high-performance Vajra syntax (.vj)

@extern
fn strcmp(s1, s2)

@extern
fn strlen(s)

@extern
fn get_char(s, i)

@extern
fn substring(s, start, end)

@extern
fn print_i64(n)

@extern
fn print_string(s)

@extern
fn get_newline_char()

@extern
fn get_tab_char()

@extern
fn get_cr_char()

# Helper to check if character is alphabetic (including UTF-8 Unicode)
fn is_alpha(c, quote_char) {
    if strcmp(c, "a") >= 0 {
        if strcmp(c, "z") <= 0 {
            return true
        }
    }
    if strcmp(c, "A") >= 0 {
        if strcmp(c, "Z") <= 0 {
            return true
        }
    }
    if strcmp(c, "_") == 0 {
        return true
    }
    # Exclude common punctuation and symbols
    if strcmp(c, "") == 0 { return false }
    if strcmp(c, " ") == 0 { return false }
    if strcmp(c, get_tab_char()) == 0 { return false }
    if strcmp(c, get_newline_char()) == 0 { return false }
    if strcmp(c, get_cr_char()) == 0 { return false }
    if strcmp(c, "(") == 0 { return false }
    if strcmp(c, ")") == 0 { return false }
    if strcmp(c, "{") == 0 { return false }
    if strcmp(c, "}") == 0 { return false }
    if strcmp(c, "[") == 0 { return false }
    if strcmp(c, "]") == 0 { return false }
    if strcmp(c, ";") == 0 { return false }
    if strcmp(c, ",") == 0 { return false }
    if strcmp(c, ".") == 0 { return false }
    if strcmp(c, "=") == 0 { return false }
    if strcmp(c, "+") == 0 { return false }
    if strcmp(c, "-") == 0 { return false }
    if strcmp(c, "*") == 0 { return false }
    if strcmp(c, "/") == 0 { return false }
    if strcmp(c, "<") == 0 { return false }
    if strcmp(c, ">") == 0 { return false }
    if strcmp(c, quote_char) == 0 { return false }
    if strcmp(c, "#") == 0 { return false }
    return true
}

# Helper to check if character is a digit
fn is_digit(c) {
    if strcmp(c, "0") >= 0 {
        if strcmp(c, "9") <= 0 {
            return true
        }
    }
    return false
}

# Skips whitespace and Pythonic comments
fn skip_whitespace_and_comments(input, pos) {
    var len = strlen(input)
    var idx = pos
    
    var loop_cond = true
    while loop_cond {
        if idx < len {
            var c = get_char(input, idx)
            if strcmp(c, " ") == 0 {
                idx = idx + 1
            } else {
                if strcmp(c, get_tab_char()) == 0 {
                    idx = idx + 1
                } else {
                    if strcmp(c, get_cr_char()) == 0 {
                        idx = idx + 1
                    } else {
                        if strcmp(c, "#") == 0 {
                            # Skip comment line
                            idx = idx + 1
                            var inner_cond = true
                            while inner_cond {
                                if idx < len {
                                    if strcmp(get_char(input, idx), get_newline_char()) == 0 {
                                        inner_cond = false
                                    } else {
                                        idx = idx + 1
                                    }
                                } else {
                                    inner_cond = false
                                }
                            }
                        } else {
                            loop_cond = false
                        }
                    }
                }
            }
        } else {
            loop_cond = false
        }
    }
    return idx
}

# Map keywords to TokenKind integer codes
fn get_keyword_kind(id) {
    if strcmp(id, "fn") == 0 { return 50 } # Function
    if strcmp(id, "कार्या") == 0 { return 50 }
    if strcmp(id, "कार्य") == 0 { return 50 }
    if strcmp(id, "def") == 0 { return 50 }
    if strcmp(id, "function") == 0 { return 50 }
    
    if strcmp(id, "let") == 0 { return 6 } # Let
    if strcmp(id, "अस्तु") == 0 { return 6 }
    if strcmp(id, "मान") == 0 { return 6 }
    if strcmp(id, "const") == 0 { return 6 }
    if strcmp(id, "var") == 0 { return 6 }
    
    if strcmp(id, "class") == 0 { return 7 } # Class
    if strcmp(id, "वर्ग") == 0 { return 7 }
    if strcmp(id, "श्रेणी") == 0 { return 7 }
    
    if strcmp(id, "if") == 0 { return 8 } # If
    if strcmp(id, "यदि") == 0 { return 8 }
    if strcmp(id, "चेत्") == 0 { return 8 }
    
    if strcmp(id, "else") == 0 { return 9 } # Else
    if strcmp(id, "अन्यथा") == 0 { return 9 }
    if strcmp(id, "नोचेत्") == 0 { return 9 }
    if strcmp(id, "elif") == 0 { return 9 }
    
    if strcmp(id, "while") == 0 { return 14 } # While
    if strcmp(id, "यावत्") == 0 { return 14 }
    if strcmp(id, "जबतक") == 0 { return 14 }
    
    if strcmp(id, "for") == 0 { return 19 } # For
    if strcmp(id, "कृते") == 0 { return 19 }
    if strcmp(id, "चक्र") == 0 { return 19 }
    
    if strcmp(id, "in") == 0 { return 20 } # In
    if strcmp(id, "अन्तः") == 0 { return 20 }
    if strcmp(id, "मध्ये") == 0 { return 20 }
    if strcmp(id, "में") == 0 { return 20 }
    if strcmp(id, "अन्दर") == 0 { return 20 }
    
    if strcmp(id, "return") == 0 { return 10 } # Return
    if strcmp(id, "प्रतिफल") == 0 { return 10 }
    if strcmp(id, "निवर्तय") == 0 { return 10 }
    
    if strcmp(id, "try") == 0 { return 15 } # Try
    if strcmp(id, "प्रयत्न") == 0 { return 15 }
    if strcmp(id, "प्रयास") == 0 { return 15 }
    
    if strcmp(id, "catch") == 0 { return 16 } # Catch
    if strcmp(id, "ग्रहण") == 0 { return 16 }
    if strcmp(id, "पकड़ें") == 0 { return 16 }
    
    if strcmp(id, "throw") == 0 { return 17 } # Throw
    if strcmp(id, "त्यज") == 0 { return 17 }
    if strcmp(id, "फेंकें") == 0 { return 17 }
    
    if strcmp(id, "import") == 0 { return 18 } # Import
    if strcmp(id, "आयात") == 0 { return 18 }
    if strcmp(id, "require") == 0 { return 18 }
    
    if strcmp(id, "spawn") == 0 { return 30 } # Spawn
    if strcmp(id, "thread") == 0 { return 30 }
    if strcmp(id, "parallel") == 0 { return 30 }
    
    if strcmp(id, "async") == 0 { return 23 } # Async
    if strcmp(id, "await") == 0 { return 24 } # Await
    if strcmp(id, "new") == 0 { return 25 } # New
    if strcmp(id, "this") == 0 { return 26 } # This
    if strcmp(id, "self") == 0 { return 26 }
    
    if strcmp(id, "true") == 0 { return 27 } # True
    if strcmp(id, "True") == 0 { return 27 }
    if strcmp(id, "सत्यम्") == 0 { return 27 }
    if strcmp(id, "सत्य") == 0 { return 27 }
    
    if strcmp(id, "false") == 0 { return 28 } # False
    if strcmp(id, "False") == 0 { return 28 }
    if strcmp(id, "असत्यम्") == 0 { return 28 }
    if strcmp(id, "असत्य") == 0 { return 28 }
    
    if strcmp(id, "null") == 0 { return 29 } # Null
    if strcmp(id, "None") == 0 { return 29 }
    if strcmp(id, "void") == 0 { return 29 }
    if strcmp(id, "शून्य") == 0 { return 29 }
    
    return 5 # Standard Identifier
}

# Packs TokenKind and Length into a single integer: kind + (len * 256)
fn lex_next_token(input, pos, quote_char) {
    var len = strlen(input)
    var idx = skip_whitespace_and_comments(input, pos)
    
    if idx >= len {
        return 1 # EOF (length 0)
    }
    
    var c = get_char(input, idx)
    
    if strcmp(c, get_newline_char()) == 0 {
        return 258 # Newline: 2 + 256
    }
    
    if strcmp(c, quote_char) == 0 {
        var start = idx
        idx = idx + 1 # skip opening quote
        var inner_cond = true
        while inner_cond {
            if idx < len {
                if strcmp(get_char(input, idx), quote_char) == 0 {
                    inner_cond = false
                } else {
                    idx = idx + 1
                }
            } else {
                inner_cond = false
            }
        }
        if idx < len {
            idx = idx + 1 # skip closing quote
        }
        var tok_len = idx - start
        var tok_len_offset = tok_len * 256
        return tok_len_offset + 3 # String
    }
    
    if is_digit(c) {
        var start = idx
        while idx < len {
            if is_digit(get_char(input, idx)) {
                idx = idx + 1
            } else {
                len = idx # break
            }
        }
        var tok_len = idx - start
        var tok_len_offset = tok_len * 256
        return tok_len_offset + 4 # Number
    }
    
    if is_alpha(c, quote_char) {
        var start = idx
        while idx < len {
            var curr = get_char(input, idx)
            if is_alpha(curr, quote_char) {
                idx = idx + 1
            } else {
                if is_digit(curr) {
                    idx = idx + 1
                } else {
                    len = idx # break
                }
            }
        }
        var tok_len = idx - start
        var id = substring(input, start, idx)
        var kind = get_keyword_kind(id)
        var tok_len_offset = tok_len * 256
        return tok_len_offset + kind
    }
    
    # Operators & Delimiters
    if strcmp(c, "=") == 0 {
        if idx + 1 < len {
            if strcmp(get_char(input, idx + 1), "=") == 0 {
                return 559 # Equal: 47 + 512
            }
        }
        return 296 # Assign: 40 + 256
    }
    
    if strcmp(c, "<") == 0 {
        if idx + 1 < len {
            if strcmp(get_char(input, idx + 1), "=") == 0 {
                return 560 # LessEqual: 48 + 512
            }
        }
        return 301 # Less: 45 + 256
    }
    
    if strcmp(c, ">") == 0 {
        if idx + 1 < len {
            if strcmp(get_char(input, idx + 1), "=") == 0 {
                return 561 # GreaterEqual: 49 + 512
            }
        }
        return 302 # Greater: 46 + 256
    }
    
    if strcmp(c, "+") == 0 { return 297 } # Plus: 41 + 256
    if strcmp(c, "-") == 0 { return 298 } # Minus: 42 + 256
    if strcmp(c, "*") == 0 { return 299 } # Star: 43 + 256
    if strcmp(c, "/") == 0 { return 300 } # Slash: 44 + 256
    if strcmp(c, "(") == 0 { return 287 } # LParen: 31 + 256
    if strcmp(c, ")") == 0 { return 288 } # RParen: 32 + 256
    if strcmp(c, "{") == 0 { return 289 } # LBrace: 33 + 256
    if strcmp(c, "}") == 0 { return 290 } # RBrace: 34 + 256
    if strcmp(c, "[") == 0 { return 291 } # LBracket: 35 + 256
    if strcmp(c, "]") == 0 { return 292 } # RBracket: 36 + 256
    if strcmp(c, ";") == 0 { return 293 } # Semicolon: 37 + 256
    if strcmp(c, ",") == 0 { return 294 } # Comma: 38 + 256
    if strcmp(c, ".") == 0 { return 295 } # Dot: 39 + 256
    
    return 0 # Unknown
}
