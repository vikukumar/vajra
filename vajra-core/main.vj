# Vajra Stage 1 Self-Hosted Compiler Toolchain CLI (v1.0.0)
# Written entirely in pure, high-performance Vajra syntax (.vj) in Hindi

@extern
fn strcmp(s1, s2)

@extern
fn strlen(s)

@extern
fn get_char(s, i)

@extern
fn printf(fmt, arg)

# CLI runtime bindings from runtime.vj
@extern
fn runtime_init(argc, argv)

@extern
fn get_argc()

@extern
fn get_argv_item(idx)

# Manifest engine bindings from manifest.vj
@extern
fn parse_project_manifest(filepath)

@extern
fn get_manifest_name()

@extern
fn get_manifest_version()

@extern
fn get_manifest_target()

@extern
fn get_manifest_entry()

@extern
fn get_manifest_description()

@extern
fn get_manifest_icon()

@extern
fn read_file_content(path)

# Parser bindings from parser.vj
@extern
fn create_parser_state(content)

@extern
fn parse_program(state)

# Emitter bindings from emitter.vj
@extern
fn cg_new(target_os)

@extern
fn compile_node(cg, ast)

@extern
fn emit_binary_file(cg, output_path)

# Static Analysis bindings from type_checker.vj & linter.vj
@extern
fn type_checker_init()

@extern
fn check_node_types(ast)

@extern
fn lint_node(ast, in_spawn_context)

# JIT Engine bindings from jit.vj
@extern
fn jit_execute_ast(ast, target_os)

# Testing Engine bindings from tester.vj
@extern
fn test_suite_init()

@extern
fn run_tests_concurrently(ast)

@extern
fn output_test_diagnostics()

@extern
fn read_line_repl(prompt)


karya compile_main() {
    astu args_count = get_argc()
    yadi args_count == 1 {
        printf("Vajra Single-Binary Unified Toolchain v1.0.0 (Self-Hosted Release)\n", 0)
        printf("Usage: vajra <command> [args]\n", 0)
        printf("\nUnified Subcommands:\n", 0)
        printf("  check <file>     : Runs static typings analysis and safety lint checker\n", 0)
        printf("  run [file]       : Launches JIT execution (pass file, or omit to launch REPL)\n", 0)
        printf("  test             : Safely executes workspace assertions in parallel\n", 0)
        printf("  build <file>     : Ahead-of-Time compiles to optimized standalone binary\n", 0)
        loutao 0
    }
    
    astu command = get_argv_item(1)
    
    # ----------------------------------------------------
    # Command: vajra check <file>
    # ----------------------------------------------------
    yadi strcmp(command, "check") == 0 {
        yadi args_count < 3 {
            printf("Error: Missing file argument for 'check' command.\n", 0)
            loutao 1
        }
        astu file_path = get_argv_item(2)
        printf("Running static analyzer over source tree: %s\n", file_path)
        
        astu content = read_file_content(file_path)
        yadi strcmp(content, "") == 0 {
            printf("Error: Could not open source file.\n", 0)
            loutao 1
        }
        
        astu parser_state = create_parser_state(content)
        astu ast = parse_program(parser_state)
        
        # Static Type Verification
        type_checker_init()
        astu types_ok = check_node_types(ast)
        
        # Safety Layout Linting
        lint_node(ast, false)
        
        yadi types_ok {
            printf("Static verification completed successfully. Zero structural errors!\n", 0)
            loutao 0
        } anyatha {
            printf("Verification failed! Static analyzer found type errors.\n", 0)
            loutao 1
        }
    }
    
    # ----------------------------------------------------
    # Command: vajra run [file] (With Interactive REPL support)
    # ----------------------------------------------------
    yadi strcmp(command, "run") == 0 {
        yadi args_count < 3 {
            # Launch Python-like Interactive REPL mode
            printf("====================================================\n", 0)
            printf("Vajra Polyglot JIT Interactive REPL (v1.0.0)\n", 0)
            printf("Type 'chapo' / 'likho' expressions. Enter 'pranam' to exit.\n", 0)
            printf("====================================================\n", 0)
            
            astu repl_loop = true
            while repl_loop {
                astu line = read_line_repl(">>> ")
                yadi strcmp(line, "pranam") == 0 {
                    repl_loop = false
                } anyatha {
                    yadi strcmp(line, "exit") == 0 {
                        repl_loop = false
                    } anyatha {
                        yadi strcmp(line, "") == 0 {
                            # Do nothing on empty line
                        } anyatha {
                            astu parser_state = create_parser_state(line)
                            astu ast = parse_program(parser_state)
                            jit_execute_ast(ast, "windows")
                        }
                    }
                }
            }
            loutao 0
        } anyatha {
            astu file_path = get_argv_item(2)
            printf("Instantly launching JIT execution for: %s\n", file_path)
            
            astu content = read_file_content(file_path)
            yadi strcmp(content, "") == 0 {
                printf("Error: Could not open source file.\n", 0)
                loutao 1
            }
            
            astu parser_state = create_parser_state(content)
            astu ast = parse_program(parser_state)
            
            # Instant memory execution via JIT segment loading
            loutao jit_execute_ast(ast, "windows")
        }
    }
    
    # ----------------------------------------------------
    # Command: vajra test
    # ----------------------------------------------------
    yadi strcmp(command, "test") == 0 {
        printf("Sweeping workspace and running concurrent test assertions...\n", 0)
        
        # Scans local tests
        astu file_path = "test.vajra" # Default test block sweep target
        astu content = read_file_content(file_path)
        yadi strcmp(content, "") == 0 {
            content = "कार्या test_addition() { write(1) }"
        }
        
        astu parser_state = create_parser_state(content)
        astu ast = parse_program(parser_state)
        
        test_suite_init()
        run_tests_concurrently(ast)
        output_test_diagnostics()
        loutao 0
    }
    
    # ----------------------------------------------------
    # Command: vajra build <file>
    # ----------------------------------------------------
    yadi strcmp(command, "build") == 0 {
        yadi args_count < 3 {
            printf("Error: Missing file argument for 'build' command.\n", 0)
            loutao 1
        }
        astu file_path = get_argv_item(2)
        
        astu manifest_parsed = parse_project_manifest("vajra.yaml")
        astu target_os = "windows"
        astu output_name = "dist/bin/output_stage1.exe"
        
        yadi manifest_parsed {
            target_os = get_manifest_target()
            output_name = get_manifest_name()
            
            printf("Manifest Loaded Successfully:\n", 0)
            printf("  Name:        %s\n", get_manifest_name())
            printf("  Version:     %s\n", get_manifest_version())
            printf("  Description: %s\n", get_manifest_description())
            printf("  Icon Path:   %s\n", get_manifest_icon())
        }
        
        # Explicit override check
        yadi args_count > 4 {
            yadi strcmp(get_argv_item(3), "-o") == 0 {
                output_name = get_argv_item(4)
            }
        }
        
        printf("Ahead-of-Time compiling... Target OS: %s\n", target_os)
        printf("Saving stand-alone optimized binary: %s\n", output_name)
        
        astu content = read_file_content(file_path)
        yadi strcmp(content, "") == 0 {
            printf("Error: Could not open source file.\n", 0)
            loutao 1
        }
        
        astu parser_state = create_parser_state(content)
        astu ast = parse_program(parser_state)
        
        astu cg = cg_new(target_os)
        compile_node(cg, ast)
        
        astu success = emit_binary_file(cg, output_name)
        yadi success {
            printf("Vajra standalone build finished successfully!\n", 0)
            loutao 0
        } anyatha {
            printf("Error: Failed to write output target binary.\n", 0)
            loutao 1
        }
    }
    
    printf("Error: Unknown subcommand '%s'\n", command)
    loutao 1
}
