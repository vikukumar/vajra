# Vajra Stage 1 Performance & Thread Safety Linter Engine (v1.0.0)
# Written entirely in pure, high-performance Vajra syntax (.vj)

@extern
fn strcmp(s1, s2)

@extern
fn printf(fmt, arg)

# AST properties from parser.vj
@extern
fn ast_get_type(node)

@extern
fn ast_get_name(node)

@extern
fn ast_get_left(node)

@extern
fn ast_get_right(node)

@extern
fn ast_get_body_size(node)

@extern
fn ast_get_body_item(node, idx)

# Natively analyzes AST patterns to detect memory safety and race warnings
fn lint_node(node, in_spawn_context) {
    if node == 0 {
        return true
    }
    
    var type = ast_get_type(node)
    
    if strcmp(type, "Program") == 0 {
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            lint_node(ast_get_body_item(node, idx), in_spawn_context)
            idx = idx + 1
        }
        return true
    }
    
    if strcmp(type, "Function") == 0 {
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            lint_node(ast_get_body_item(node, idx), in_spawn_context)
            idx = idx + 1
        }
        return true
    }
    
    if strcmp(type, "SpawnCall") == 0 {
        # Entering asynchronous spawned task context
        # Warn if concurrent block accesses shared mutable variables
        var task = ast_get_left(node)
        lint_node(task, true)
        return true
    }
    
    if strcmp(type, "Let") == 0 {
        var name = ast_get_name(node)
        if in_spawn_context {
            printf("Lint Warning: Variable '%s' declared inside parallel spawn context without explicit locks.\n", name)
        }
        
        var left = ast_get_left(node)
        if left == 0 {
            # do nothing
        } else {
            lint_node(left, in_spawn_context)
        }
        return true
    }
    
    if strcmp(type, "While") == 0 {
        # Check for constant dead code conditions
        var cond = ast_get_left(node)
        if strcmp(ast_get_type(cond), "Literal") == 0 {
            var val = ast_get_left(cond)
            if strcmp(val, "0") == 0 {
                printf("Lint Warning: Dead code detected! while loop has constant false condition.\n", 0)
            }
        }
        
        # Traverse loop body statements
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            lint_node(ast_get_body_item(node, idx), in_spawn_context)
            idx = idx + 1
        }
        return true
    }
    
    if strcmp(type, "ExpressionStatement") == 0 {
        lint_node(ast_get_left(node), in_spawn_context)
    }
    
    return true
}
