# Vajra Stage 1 Strict Static Type Checker Engine (v1.0.0)
# Written entirely in pure, high-performance Vajra syntax (.vj)

@extern
fn strcmp(s1, s2)

@extern
fn printf(fmt, arg)

@extern
fn malloc(size)

@extern
fn free(ptr)

@extern
fn pointer_read_i64(ptr, offset)

@extern
fn pointer_write_i64(ptr, offset, val)

# AST properties from parser.vj
@extern
fn ast_get_type(node)

@extern
fn ast_get_name(node)

@extern
fn ast_get_left(node)

@extern
fn ast_get_right(node)

@extern
fn ast_get_body_size(node)

@extern
fn ast_get_body_item(node, idx)

@extern
fn ast_get_args_size(node)

@extern
fn ast_get_args_item(node, idx)

# Emulated global storage setters/getters
@extern
fn set_symbol_table_names(val)

@extern
fn get_symbol_table_names()

@extern
fn set_symbol_table_size(val)

@extern
fn get_symbol_table_size()

@extern
fn set_symbol_table_cap(val)

@extern
fn get_symbol_table_cap()

fn type_checker_init() {
    set_symbol_table_names(malloc(512))
    set_symbol_table_size(0)
}

fn add_symbol(name) {
    var size = get_symbol_table_size()
    var cap = get_symbol_table_cap()
    if size < cap {
        pointer_write_i64(get_symbol_table_names(), size, name)
        set_symbol_table_size(size + 1)
    }
}

fn has_symbol(name) {
    var idx = 0
    var size = get_symbol_table_size()
    while idx < size {
        var sym = pointer_read_i64(get_symbol_table_names(), idx)
        if strcmp(sym, name) == 0 {
            return true
        }
        idx = idx + 1
    }
    return false
}

# Recursively scans and validates AST typings
fn check_node_types(node) {
    if node == 0 {
        return true
    }
    
    var type = ast_get_type(node)
    
    if strcmp(type, "Program") == 0 {
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            var res = check_node_types(ast_get_body_item(node, idx))
            if res == false {
                return false
            }
            idx = idx + 1
        }
        return true
    }
    
    if strcmp(type, "Let") == 0 {
        var name = ast_get_name(node)
        add_symbol(name)
        
        # Verify initializer type
        var left = ast_get_left(node)
        if left == 0 {
            # do nothing
        } else {
            return check_node_types(left)
        }
        return true
    }
    
    if strcmp(type, "Function") == 0 {
        var name = ast_get_name(node)
        add_symbol(name)
        
        # Verify function body statement typings
        var idx = 0
        var len = ast_get_body_size(node)
        while idx < len {
            var res = check_node_types(ast_get_body_item(node, idx))
            if res == false {
                return false
            }
            idx = idx + 1
        }
        return true
    }
    
    if strcmp(type, "Identifier") == 0 {
        var name = ast_get_name(node)
        if has_symbol(name) {
            return true
        }
        # Static type check error: undefined reference
        printf("Type Check Error: Undefined identifier reference '%s'\n", name)
        return false
    }
    
    if strcmp(type, "FunctionCall") == 0 {
        var name = ast_get_name(node)
        if has_symbol(name) {
            # Check function call arguments typings
            var idx = 0
            var len = ast_get_args_size(node)
            while idx < len {
                var res = check_node_types(ast_get_args_item(node, idx))
                if res == false {
                    return false
                }
                idx = idx + 1
            }
            return true
        }
        printf("Type Check Error: Call to undefined function '%s'\n", name)
        return false
    }
    
    if strcmp(type, "BinaryOp") == 0 {
        var left_ok = check_node_types(ast_get_left(node))
        var right_ok = check_node_types(ast_get_right(node))
        if left_ok {
            if right_ok {
                return true
            }
        }
        return false
    }
    
    if strcmp(type, "ExpressionStatement") == 0 {
        return check_node_types(ast_get_left(node))
    }
    
    if strcmp(type, "Return") == 0 {
        return check_node_types(ast_get_left(node))
    }
    
    return true
}
