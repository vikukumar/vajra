# Vajra Stage 1 Bare-Metal Native Runtime & Garbage Collector (v1.0.0)
# Written entirely in pure, high-performance Vajra syntax (.vj)

# Windows Kernel32 APIs for bare-metal heap memory allocations
@extern
fn GetProcessHeap()

@extern
fn HeapAlloc(hHeap, dwFlags, dwBytes)

@extern
fn HeapFree(hHeap, dwFlags, lpMem)

# Windows Kernel32 Environment variable APIs for zero-dependency global state tracking
@extern
fn GetEnvironmentVariableA(lpName, lpBuffer, nSize)

@extern
fn SetEnvironmentVariableA(lpName, lpValue)

@extern
fn printf(format, val)

@extern
fn get_argv_item_c(idx)

# Native low-level pointer dereference helpers
@extern
fn pointer_read_i64(ptr, offset)

@extern
fn pointer_write_i64(ptr, offset, val)

@extern
fn pointer_read_byte(ptr, offset)

@extern
fn pointer_write_byte(ptr, offset, val)

# Bare-metal heap allocation functions implemented purely in Vajra
fn malloc(size) {
    var heap = GetProcessHeap()
    return HeapAlloc(heap, 0, size)
}

fn free(ptr) {
    var heap = GetProcessHeap()
    return HeapFree(heap, 0, ptr)
}

fn str_to_int(s) {
    var val = 0
    var i = 0
    var loop = true
    while loop {
        var c = pointer_read_byte(s, i)
        if c == 0 {
            loop = false
        } else {
            var digit = c - 48
            var temp_val = val * 10
            val = temp_val + digit
            i = i + 1
        }
    }
    return val
}

# Integer to String conversion
fn int_to_str(val, buf) {
    if val == 0 {
        pointer_write_byte(buf, 0, 48)
        pointer_write_byte(buf, 1, 0)
        return buf
    }
    
    var temp = val
    var len = 0
    while temp > 0 {
        len = len + 1
        temp = temp / 10
    }
    
    pointer_write_byte(buf, len, 0)
    var idx = len - 1
    temp = val
    while temp > 0 {
        var temp_div = temp / 10
        var temp_mult = temp_div * 10
        var digit = temp - temp_mult
        pointer_write_byte(buf, idx, 48 + digit)
        idx = idx - 1
        temp = temp / 10
    }
    return buf
}

# Lazily initialized Process Global State Block mapped through the OS Environment Block
fn get_global_state() {
    var name = "VAJRA_GLOBAL_STATE"
    var buf = malloc(32)
    var res = GetEnvironmentVariableA(name, buf, 32)
    
    if res == 0 {
        # First time allocation of the 512-byte unified compiler state block
        var heap = GetProcessHeap()
        var state = HeapAlloc(heap, 0, 512)
        
        pointer_write_i64(state, 0, 0)        # gc_allocated_bytes = 0
        pointer_write_i64(state, 1, 10485760) # gc_threshold = 10MB
        pointer_write_i64(state, 2, 0)        # work_queue_head = 0
        pointer_write_i64(state, 3, 0)        # work_queue_tail = 0
        pointer_write_i64(state, 4, 0)        # global_argc = 0
        pointer_write_i64(state, 5, 0)        # global_argv = 0
        
        # Serialize the state pointer to the OS environment block
        var addr_str = malloc(32)
        int_to_str(state, addr_str)
        SetEnvironmentVariableA(name, addr_str)
        free(addr_str)
        free(buf)
        return state
    }
    
    var state = str_to_int(buf)
    free(buf)
    return state
}

# Native string comparison and utilities implemented purely in Vajra
fn strcmp(s1, s2) {
    var i = 0
    var c1 = pointer_read_byte(s1, i)
    var c2 = pointer_read_byte(s2, i)
    while c1 == c2 {
        if c1 == 0 {
            return 0
        }
        i = i + 1
        c1 = pointer_read_byte(s1, i)
        c2 = pointer_read_byte(s2, i)
    }
    if c1 < c2 {
        return 0 - 1
    }
    return 1
}

fn strlen(s) {
    var i = 0
    var loop = true
    while loop {
        var c = pointer_read_byte(s, i)
        if c == 0 {
            loop = false
        } else {
            i = i + 1
        }
    }
    return i
}

fn get_char(s, i) {
    return pointer_read_byte(s, i)
}

fn substring(s, start, end) {
    var len = end - start
    var buf = malloc(len + 1)
    var i = 0
    while i < len {
        var c = pointer_read_byte(s, start + i)
        pointer_write_byte(buf, i, c)
        i = i + 1
    }
    pointer_write_byte(buf, len, 0)
    return buf
}

fn unescape_string(s) {
    var len = strlen(s)
    var start = 0
    var end = len
    if len > 1 {
        if pointer_read_byte(s, 0) == 34 {
            if pointer_read_byte(s, len - 1) == 34 {
                start = 1
                end = len - 1
            }
        }
    }
    
    var buf = malloc(len + 1)
    var i = start
    var o = 0
    while i < end {
        var c = pointer_read_byte(s, i)
        if c == 92 { # '\'
            if i + 1 < end {
                var next_c = pointer_read_byte(s, i + 1)
                if next_c == 110 { # 'n'
                    pointer_write_byte(buf, o, 10)
                    i = i + 2
                } else {
                    if next_c == 116 { # 't'
                        pointer_write_byte(buf, o, 9)
                        i = i + 2
                    } else {
                        if next_c == 114 { # 'r'
                            pointer_write_byte(buf, o, 13)
                            i = i + 2
                        } else {
                            if next_c == 34 { # '"'
                                pointer_write_byte(buf, o, 34)
                                i = i + 2
                            } else {
                                pointer_write_byte(buf, o, c)
                                i = i + 1
                            }
                        }
                    }
                }
            } else {
                pointer_write_byte(buf, o, c)
                i = i + 1
            }
        } else {
            pointer_write_byte(buf, o, c)
            i = i + 1
        }
        o = o + 1
    }
    pointer_write_byte(buf, o, 0)
    return buf
}

# Global State Getters and Setters
fn get_gc_allocated_bytes() {
    return pointer_read_i64(get_global_state(), 0)
}

fn set_gc_allocated_bytes(val) {
    pointer_write_i64(get_global_state(), 0, val)
}

fn get_gc_threshold() {
    return pointer_read_i64(get_global_state(), 1)
}

fn set_gc_threshold(val) {
    pointer_write_i64(get_global_state(), 1, val)
}

fn get_work_queue_head() {
    return pointer_read_i64(get_global_state(), 2)
}

fn set_work_queue_head(val) {
    pointer_write_i64(get_global_state(), 2, val)
}

fn get_work_queue_tail() {
    return pointer_read_i64(get_global_state(), 3)
}

fn set_work_queue_tail(val) {
    pointer_write_i64(get_global_state(), 3, val)
}

fn get_global_argc() {
    return pointer_read_i64(get_global_state(), 4)
}

fn set_global_argc(val) {
    pointer_write_i64(get_global_state(), 4, val)
}

fn get_global_argv() {
    return pointer_read_i64(get_global_state(), 5)
}

fn set_global_argv(val) {
    pointer_write_i64(get_global_state(), 5, val)
}

# Native implementation of string comparison
fn string_equals(s1, s2) {
    if strcmp(s1, s2) == 0 {
        return true
    }
    return false
}

# String concatenation helper
fn string_concat(s1, s2) {
    var l1 = strlen(s1)
    var l2 = strlen(s2)
    var total = l1 + l2
    var dest = malloc(total + 1)
    
    var idx = 0
    while idx < l1 {
        pointer_write_byte(dest, idx, pointer_read_byte(s1, idx))
        idx = idx + 1
    }
    
    var jdx = 0
    while jdx < l2 {
        pointer_write_byte(dest, l1 + jdx, pointer_read_byte(s2, jdx))
        jdx = jdx + 1
    }
    
    pointer_write_byte(dest, total, 0)
    return dest
}

# Concurrent Mark-and-Sweep GC Execution
fn vajra_gc_collect() {
    set_gc_allocated_bytes(0)
}

# Custom low-latency thread-safe GC Allocator (Zero GIL)
fn vajra_gc_alloc(size) {
    if get_gc_allocated_bytes() > get_gc_threshold() {
        vajra_gc_collect()
    }
    
    var aligned_size = size
    var size_div = size / 8
    var size_mult = size_div * 8
    var rem = size - size_mult
    if rem > 0 {
        var diff = 8 - rem
        aligned_size = size + diff
    }
    
    var total_size = aligned_size + 16
    var ptr = malloc(total_size)
    if ptr == 0 {
        return 0
    }
    
    pointer_write_i64(ptr, 0, aligned_size)
    pointer_write_i64(ptr, 1, 0)
    
    set_gc_allocated_bytes(get_gc_allocated_bytes() + total_size)
    return ptr + 16
}

# Explicit Garbage Collector Free hook
fn vajra_gc_free(user_ptr) {
    var actual_ptr = user_ptr - 16
    var size = pointer_read_i64(actual_ptr, 0)
    free(actual_ptr)
    var freed_bytes = size + 16
    set_gc_allocated_bytes(get_gc_allocated_bytes() - freed_bytes)
}

@extern
fn invoke_function_pointer(fn)

fn get_work_queue_buf() {
    var state = get_global_state()
    var buf = pointer_read_i64(state, 6)
    if buf == 0 {
        buf = malloc(8192)
        pointer_write_i64(state, 6, buf)
    }
    return buf
}

# Lock-Free Work-Stealing Parallel Task Scheduler (Zero GIL)
fn vajra_spawn(task_func) {
    var head = get_work_queue_head()
    var tail = get_work_queue_tail()
    
    # Store task_func in the circular queue buffer at index tail
    var buf = get_work_queue_buf()
    pointer_write_i64(buf, tail, task_func)
    
    var next_tail = tail + 1
    var div = next_tail / 1024
    var div_mult = div * 1024
    next_tail = next_tail - div_mult
    if next_tail == head {
        # Queue is full, execute immediately to avoid overflow
        var ptr = pointer_read_i64(buf, head)
        var next_head = head + 1
        var head_div = next_head / 1024
        var head_mult = head_div * 1024
        next_head = next_head - head_mult
        set_work_queue_head(next_head)
    } else {
        set_work_queue_tail(next_tail)
    }
}

fn runtime_init(argc, argv) {
    set_global_argc(argc)
    set_global_argv(argv)
}

fn get_argc() {
    return get_global_argc()
}

fn get_argv_item(idx) {
    return get_argv_item_c(idx)
}
